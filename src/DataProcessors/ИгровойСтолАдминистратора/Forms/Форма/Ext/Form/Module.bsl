		Пока Выборка.Следующий() Цикл
			
			ТекущаяДатаСеанса = ТекущаяДатаСеанса();
			
			Если ТекущаяДатаСеанса>=Выборка.ВремяЗавершения Тогда // уже проскачили по времени				
				СообщениеРезультат = "Текущая задача уже не активна. Повторите попытку";				
				
			Иначе // - это исполняемая активная задача					
				
				Если ЗначениеЗаполнено(Выборка.ВремяОкончанияПаузы) Тогда 
					
					Если ТекущаяДатаСеанса>Выборка.ВремяОкончанияПаузы Тогда 
						// Т.е. пауза была, но уже прошла, тогда устанавливаем новую				
						Новое_ВремяНачалаПаузы    = ТекущаяДатаСеанса; 
						Новое_ВремяОкончанияПаузы = Новое_ВремяНачалаПаузы + ДлительностьПаузы;
						Новое_ВремяЗавершения     = Выборка.ВремяЗавершения + ДлительностьПаузы;
					Иначе // сейчас эта пауза активна, поэтому отменяем её			
						Новое_ВремяНачалаПаузы    = Выборка.ВремяНачалаПаузы; 
						Новое_ВремяОкончанияПаузы = ТекущаяДатаСеанса - 1;
						Новое_ВремяЗавершения     = Выборка.ВремяЗавершения - (Выборка.ВремяОкончанияПаузы-ТекущаяДатаСеанса) + 1;
					КонецЕсли;
					
				Иначе // устанавливаем новую*
					Новое_ВремяНачалаПаузы    = ТекущаяДатаСеанса; 
					Новое_ВремяОкончанияПаузы = Новое_ВремяНачалаПаузы + ДлительностьПаузы;
					Новое_ВремяЗавершения     = Выборка.ВремяЗавершения + ДлительностьПаузы;
				КонецЕсли; 									
				
				// Обновление текущей записи		
				Запись = РегистрыСведений.МаршрутПроведенияИгры.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(Запись,Выборка,"Игра,АктивныйВопрос,НомерСледования");
				Запись.Прочитать();
				
				Если Запись.Выбран() Тогда
					Запись.ВремяНачалаПаузы = Новое_ВремяНачалаПаузы;
					Запись.ВремяОкончанияПаузы = Новое_ВремяОкончанияПаузы;
					Запись.ВремяЗавершения = Новое_ВремяЗавершения;
					ЗаполнитьЗначенияСвойств(Объект, Запись); // Обновление данных формы после выполнения команды
					Запись.Записать(Истина);				
				КонецЕсли;	
				
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		СообщениеРезультат = "Нет активно выполнаемой задачи!";
	КонецЕсли;
	
	Элементы.МаршрутИгры.Обновить();
	
	Возврат СообщениеРезультат;
	
