// Обработчики событий
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Текущая игра
	Объект.Игра = Константы.ТекущаяИгра.Получить();
	
	// Получение данных текущего вопроса, синхронизациz времени
	СтрОбъект = ПолучитьДанныеТекущегоВопроса_ОбновитьСинхронизациюСВремениСервера(Объект.Игра);
	ЗаполнитьЗначенияСвойств(Объект, СтрОбъект);
	
	
	// Проверка основного администратора игры	
	ФормаДоступнаТолькоНаПросмотр = НЕ Проверить_ЭтоАдминистарорИгры();
	
	Если НЕ ФормаДоступнаТолькоНаПросмотр Тогда
		// Если есть активная задача> СТАРТ ИГРЫ
		Объект.АктивныйХодИгры = СтрОбъект.ЕстьАктивныйВопрос;
	Иначе
		Элементы.Игра.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	// Отборы:
	УстановитьОтборПоИгреВДинамическихСписках();
	
	
	// Значения по-умолчанию:
	ДлительностьПаузы = 60;
	ДлительностьДобавленногоВремени = 60;
	ДлительностьОставленногоВремени = 10;	
	
	// Только для полных прав
	Элементы.ОткрытьКонстантуАдминистраторИгры.Доступность = РольДоступна("ПолныеПрава");
	
	// Переменная запоняется при запуске игрового стола и позволяет играть с разными часовыми поясами
	// в одно и тоже время on-line 
	Объект.ТекущаяДатаСеансаНаСервере = ТекущаяДатаСеанса();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Переменная запоняется при запуске игрового стола и позволяет играть с разными часовыми поясами
	// в одно и тоже время on-line 
	Объект.СинхронизацияСВременемСервера = Объект.ТекущаяДатаСеансаНаСервере - ТекущаяДата();

	
	Если ФормаДоступнаТолькоНаПросмотр Тогда
		ПоказатьПредупреждение(,"Форма доступна только для просмотра!");
	КонецЕсли;
	
	// Обновление доступности кнопок СТАРТ/STOP
	ДоступностьКнопок_СТАРТ_СТОП();
	
	// СТАРТ: счетчика Времени
	ПодключитьОбработчикОжидания("ОбновитьДанные_ОперативныйСчетчикВремени", 0.3, Истина);
	
	// СТАРТ: обновления игровых данных из базы
	ПодключитьОбработчикОжидания("ОбновитьДанные_ХодИгры", 1);	// - запускается 1 раз при открытии формы	
	
КонецПроцедуры

&НаКлиенте
Процедура ИграПриИзменении(Элемент)
	
	ИграПриИзмененииНаСервере();
	ДоступностьКнопок_СТАРТ_СТОП();
	
КонецПроцедуры

&НаСервере
Процедура ИграПриИзмененииНаСервере()
	
	// Изменение игры
	Если ЗначениеЗаполнено(Объект.Игра) Тогда	
		Если Объект.Игра.Проведен Тогда
			Константы.ТекущаяИгра.Установить(Объект.Игра);
		Иначе			
			ИгровойКлиентСервер.СообщитьПользователю("В качестве игры можно выбирать только проведенный документ!", , "Объект.Игра", "Объект.Игра");
			Объект.Игра = Документы.Игра.ПустаяСсылка();
		КонецЕсли;	
	КонецЕсли;	
	
	// Всегда отменяем активные действия после изменения игры
	Объект.АктивныйХодИгры = Ложь;
	
	
	// Получение данных текущего вопроса, синхронизации времени
	СтрОбъект = ПолучитьДанныеТекущегоВопроса_ОбновитьСинхронизациюСВремениСервера(Объект.Игра);
	ЗаполнитьЗначенияСвойств(Объект, СтрОбъект);
	
	// Отборы Динамических списков
	УстановитьОтборПоИгреВДинамическихСписках();
	
КонецПроцедуры

&НаКлиенте            
Процедура МаршрутИгрыПриАктивизацииСтроки(Элемент)
	
	// Номер для старта с текущей задачи
	АктивныйНомер = ?(Элемент.ТекущиеДанные<>Неопределено, Элемент.ТекущиеДанные.НомерСледования, 0);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	// Т.к. форма является одновременно и службой хода игры, то обязательно предупреждаем
	Если НЕ ЗавершениеРаботы И Объект.АктивныйХодИгры И НЕ ФормаДоступнаТолькоНаПросмотр Тогда
		Отказ = Истина;
		Оповещение = Новый ОписаниеОповещения("ПередЗакрытиемОбработкаВопроса", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, "Идёт активный ход игры.
		|Закрытие приведёт к прекращению работы механизма перехода к следующей задаче.
		|Все равно закрыть?",РежимДиалогаВопрос.ДаНет);		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемОбработкаВопроса(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Объект.АктивныйХодИгры = Ложь;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры




