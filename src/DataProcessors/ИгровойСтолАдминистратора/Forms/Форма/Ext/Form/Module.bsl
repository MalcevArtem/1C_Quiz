


// Процедуры и функции (подключенные обработчики)	
&НаКлиенте
Процедура ОбновитьДанные_ОперативныйСчетчикВремени()
	
	ВремяНаСервере = ТекущаяДата() + Объект.СинхронизацияСВременемСервера;	
	
	Если ВремяНаСервере<=Объект.ВремяОкончанияПаузы Тогда
		
		ТекстИнформация_ПаузаИгра = "<Пауза>";
		ВремяСекунд = МАКС(Объект.ВремяОкончанияПаузы-ВремяНаСервере,0);	
		Если ВремяСекунд<=5 Тогда
			Цвет = WebЦвета.КрасноФиолетовый;
		Иначе
			Цвет = WebЦвета.Фиолетовый;
		КонецЕсли;
		
	Иначе 	
		
		ВремяСекунд = МАКС(Объект.ВремяЗавершения-ВремяНаСервере,0);
		
		Если ВремяНаСервере<=Объект.ВремяЗавершения Тогда // еще не истекло время			
			ТекстИнформация_ПаузаИгра = "Игра";
			Если Объект.ВремяЗавершения-ВремяНаСервере>5 Тогда
				Цвет = WebЦвета.Зеленый;
			Иначе	
				Цвет = WebЦвета.Красный
			КонецЕсли;			
		Иначе // время истекло а вопрос не сменился			
			Если ВремяНаСервере<Объект.ВремяЗавершения+10 Тогда
				ТекстИнформация_ПаузаИгра = "Игра";
				Цвет = WebЦвета.Красный;
			Иначе			
				ТекстИнформация_ПаузаИгра = "Игра остановлена";
				Цвет = WebЦвета.Черный;
			КонецЕсли;				
		КонецЕсли;
		
	КонецЕсли;	
	
	Если ТекстИнформация_ПаузаИгра<>Информация_ПаузаИгра Тогда
		Информация_ПаузаИгра = ТекстИнформация_ПаузаИгра;
	КонецЕсли;
	
	Информация_Время = ИгровойКлиент.ПолучитьВремяВЧасахМинутахИСекундах(ВремяСекунд);
	Если Элементы.Информация_Время.ЦветТекста<>Цвет Тогда
		Элементы.Информация_Время.ЦветТекста = Цвет; 
	КонецЕсли;
	
	Заголовок = СокрЛП(Объект.ВопросНаименование);
	
	ПодключитьОбработчикОжидания("ОбновитьДанные_ОперативныйСчетчикВремени", 0.3, Истина);   // 0.3 - идеально:)
	
КонецПроцедуры	

&НаКлиенте
Процедура ОбновитьДанные_ХодИгры()
	
	Если ЗначениеЗаполнено(Объект.Игра) Тогда
		
		Если ФормаДоступнаТолькоНаПросмотр Тогда // Только обновление данных
			
			// Получение данных текущего вопроса, синхронизации времени
			СтрОбъект = ПолучитьДанныеТекущегоВопроса_ОбновитьСинхронизациюСВремениСервера(Объект.Игра);
			Если СтрОбъект.НомерСледования<>Объект.НомерСледования Тогда // Изменился номер следования
				Элементы.МаршрутИгры.Обновить();
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(Объект, СтрОбъект);
			Объект.СинхронизацияСВременемСервера = Объект.ТекущаяДатаСеансаНаСервере - ТекущаяДата();
			
		Иначе
			
			// Обновление данных строки состояния
			Объект.СтрокаСостояния = ИгровойСерверПривилегированный.ОбновитьИнформациюСтрокиСостоянияТекущегоВопроса(Объект.Игра);
			
			// Т.к. данные в регистре могут обновляться только одним человеком - это администратор игры
			// то нет смысла частых запросов к информационной базе
			// Проверка дат завершения задания для переключения Хода игры на следующие по номеру следования вопрос
			Если Объект.ВремяЗавершения <= (ТекущаяДата()+Объект.СинхронизацияСВременемСервера) Тогда // Как только сравнялись - делаем запросы	
				Если Объект.АктивныйХодИгры И ЗначениеЗаполнено(Объект.Игра) Тогда	
					Если ЕстьВозможностьЗаписиВРегистрМаршрутПроведенияИгры() Тогда
						СтрОбъект = ПроверитьВыполнитьСледующийХод(Объект.Игра);
						ЗаполнитьЗначенияСвойств(Объект, СтрОбъект);
						Объект.СинхронизацияСВременемСервера = Объект.ТекущаяДатаСеансаНаСервере - ТекущаяДата();
						Если СтрОбъект.ЭтоНоваяЗапись=Истина Тогда Элементы.МаршрутИгры.Обновить(); КонецЕсли;
						Блокировка_РегистрМаршрутаЗанят = ?(Блокировка_РегистрМаршрутаЗанят, Ложь, Истина);		
					Иначе
						Сообщить("Конфликт разделенного доступа для записи в регистр сведений ""МаршрутПроведенияИгры""");
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьВыполнитьСледующийХод(Игра)
	
	// Процедура соуществляющая переход на следующую строку маршрута
	//
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	МаршрутПроведенияИгры.Игра КАК Игра,
	|	МаршрутПроведенияИгры.АктивныйВопрос КАК АктивныйВопрос,
	|	МаршрутПроведенияИгры.НомерСледования КАК НомерСледования,
	|	МаршрутПроведенияИгры.Вопрос КАК Вопрос,
	|	ВЫБОР
	|		КОГДА МаршрутПроведенияИгры.ВремяЗавершения < &ТекущаяДатаСеанса
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ХодЗавершен,
	|	МаршрутПроведенияИгры.ВремяОкончанияПаузы КАК ВремяОкончанияПаузы,
	|	МаршрутПроведенияИгры.ВремяЗавершения КАК ВремяЗавершения
	|ПОМЕСТИТЬ ЗавершенныйХод
	|ИЗ
	|	РегистрСведений.МаршрутПроведенияИгры КАК МаршрутПроведенияИгры
	|ГДЕ
	|	МаршрутПроведенияИгры.АктивныйВопрос
	|	И МаршрутПроведенияИгры.Игра = &Игра
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСледования УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	МаршрутПроведенияИгры.Игра КАК Игра,
	|	МаршрутПроведенияИгры.АктивныйВопрос КАК АктивныйВопрос,
	|	МаршрутПроведенияИгры.НомерСледования КАК НомерСледования,
	|	МаршрутПроведенияИгры.Вопрос КАК Вопрос
	|ИЗ
	|	ЗавершенныйХод КАК ЗавершенныйХод
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.МаршрутПроведенияИгры КАК МаршрутПроведенияИгры
	|		ПО ЗавершенныйХод.Игра = МаршрутПроведенияИгры.Игра
	|			И (ЗавершенныйХод.ХодЗавершен)
	|			И ЗавершенныйХод.НомерСледования < МаршрутПроведенияИгры.НомерСледования
	|
	|УПОРЯДОЧИТЬ ПО
	|	МаршрутПроведенияИгры.НомерСледования
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗавершенныйХод.Игра КАК Игра,
	|	ЗавершенныйХод.АктивныйВопрос КАК АктивныйВопрос,
	|	ЗавершенныйХод.НомерСледования КАК НомерСледования,
	|	ЗавершенныйХод.Вопрос КАК Вопрос,
	|	ЗавершенныйХод.ВремяОкончанияПаузы КАК ВремяОкончанияПаузы,
	|	ЗавершенныйХод.ВремяЗавершения КАК ВремяЗавершения
	|ИЗ
	|	ЗавершенныйХод КАК ЗавершенныйХод";	
	Запрос.УстановитьПараметр("Игра",              Игра);
	Запрос.УстановитьПараметр("ТекущаяДатаСеанса", ТекущаяДатаСеанса());
	
	МассивРезультатов = Запрос.ВыполнитьПакет();	
	
	СтрОбъект = Новый Структура("ЭтоНоваяЗапись,НомерСледования,ВремяОкончанияПаузы,ВремяЗавершения,Вопрос,ТекущаяДатаСеансаНаСервере");
	
	ВыборкаНовыйХод = МассивРезультатов[1].Выбрать(); // - выборка 1 записи следующего хода
	Если ВыборкаНовыйХод.Количество()>0 Тогда
		ВыборкаНовыйХод.Следующий();
		
		// Делаем активной новую и снимаем активность у старой записи. СтрОбъект - новая запись.	
		
		// Обновление записи Нового* хода	
		Запись = РегистрыСведений.МаршрутПроведенияИгры.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, ВыборкаНовыйХод);	
		Запись.Прочитать();
		
		Если Запись.Выбран() Тогда			
			Запись.АктивныйВопрос = Истина; // Изменение активности записи
			Запись.ВремяСтарта = ТекущаяДатаСеанса();
			Запись.ВремяНачалаПаузы = Дата(1,1,1);
			Запись.ВремяОкончанияПаузы = Дата(1,1,1);
			Запись.Длительность = ?(ЗначениеЗаполнено(Запись.Длительность), Запись.Длительность, 60);
			Запись.ВремяЗавершения = Запись.ВремяСтарта + Запись.Длительность;	
			Запись.Записать(Истина);	
			
			ЗаполнитьЗначенияСвойств(СтрОбъект, Запись); 
			СтрОбъект.ЭтоНоваяЗапись = Истина;			
		КонецЕсли;	
		
		
		// Убираем активность со старой записи
		ВыборкаСтарыйХод = МассивРезультатов[2].Выбрать(); // - выборка 1 записи старого, уже завершенного хода
		ВыборкаСтарыйХод.Следующий();
		// Обновление записи Старого хода	
		Запись = РегистрыСведений.МаршрутПроведенияИгры.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, ВыборкаСтарыйХод);	
		Запись.Прочитать();		
		Если Запись.Выбран() Тогда			
			Запись.АктивныйВопрос = Ложь; // Изменение активности записи		
			Запись.Записать(Истина);		
		КонецЕсли;			
		
	Иначе
		
		ВыборкаСтарыйХод = МассивРезультатов[2].Выбрать(); // - выборка 1 записи старого, ещё не завершенного хода
		Если ВыборкаСтарыйХод.Количество()>0 Тогда
			ВыборкаСтарыйХод.Следующий();
			ЗаполнитьЗначенияСвойств(СтрОбъект, ВыборкаСтарыйХод);	
			СтрОбъект.ЭтоНоваяЗапись = Ложь;
		КонецЕсли;
		
	КонецЕсли;	
		
	// Наименование вопроса для Заголовка
	Если ЗначениеЗаполнено(СтрОбъект.Вопрос) Тогда
		СтрОбъект.Вставить("ВопросНаименование", СокрЛП(СтрОбъект.Вопрос.Наименование));    // 777 Оптимизация
	КонецЕсли;
	
	// Для синхронизации с временем Сервера
	СтрОбъект.ТекущаяДатаСеансаНаСервере = ТекущаяДатаСеанса();
	
	Возврат СтрОбъект;
	
КонецФункции




// Процедуры и функции (общие)
&НаКлиенте
Функция ЕстьВозможностьЗаписиВРегистрМаршрутПроведенияИгры()
	
	Если НЕ Блокировка_РегистрМаршрутаЗанят Тогда
		
		Блокировка_РегистрМаршрутаЗанят = Истина;
		Блокировка_ВремяУстановкиНаРегистрМаршрута = ТекущаяДата() + Объект.СинхронизацияСВременемСервера;
		Возврат Истина;		
		
	Иначе // идет изменение
		
		Если (ТекущаяДата()+Объект.СинхронизацияСВременемСервера)-Блокировка_ВремяУстановкиНаРегистрМаршрута>3 Тогда
			
			// слишком долго, поэтому мы обрываем процесс старый обновления
			Блокировка_ВремяУстановкиНаРегистрМаршрута = ТекущаяДата()+Объект.СинхронизацияСВременемСервера;
			Возврат Истина;				
			
		Иначе
			Возврат Ложь; // Ждём
		КонецЕсли;			
		
	КонецЕсли;	
	
КонецФункции	

&НаСервере
Процедура УстановитьОтборПоИгреВДинамическихСписках()
	
	// Устанавливаем фиксированнный отбор в ДинамическихСписках
	//
	
	// МаршрутИгры
	ФиксированныйОтбор = МаршрутИгры.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы;
	ФиксированныйОтбор.Очистить();	
	ЭлементОтбора = ФиксированныйОтбор.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Игра");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Объект.Игра;
	
	// МаршрутПроведенияИгры
	ФиксированныйОтбор = МаршрутПроведенияИгры.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы;
	ФиксированныйОтбор.Очистить();	
	ЭлементОтбора = ФиксированныйОтбор.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Игра");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Объект.Игра;
	Элементы.МаршрутПроведенияИгры.Обновить(); // - почему-то не обновляется только этот список, поэтому принудительно обновляем только его :)
	
	// ОтветыКоманд
	ФиксированныйОтбор = ОтветыКоманд.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы;
	ФиксированныйОтбор.Очистить();	
	ЭлементОтбора = ФиксированныйОтбор.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Игра");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Объект.Игра;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция Проверить_ЭтоАдминистарорИгры()
	
	АдминистраторИгры = Константы.АдминистраторИгры.Получить();
	Если НЕ ЗначениеЗаполнено(АдминистраторИгры) Тогда
		Сообщить("Не установлен администратор игры!        [Констант.АдминистраторИгры]");
		ЭтоАдминистарорИгры = Ложь;
	Иначе
		Если АдминистраторИгры<>ПараметрыСеанса.ТекущийПользователь Тогда
			Сообщить("Установленный администратор игры """+СокрЛП(АдминистраторИгры)+""" не соответствует текущему пользователю """+СокрЛП(ПараметрыСеанса.ТекущийПользователь)+"""        [Констант.АдминистраторИгры]");
			ЭтоАдминистарорИгры = Ложь;
		Иначе
			ЭтоАдминистарорИгры = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЭтоАдминистарорИгры;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДанныеТекущегоВопроса_ОбновитьСинхронизациюСВремениСервера(Игра)
	
	// Обновление данных текущего вопроса
	СтрОбъект = ИгровойСерверПривилегированный.ПолучитьДанныеТекущегоВопроса(Игра);
	
	// Наименование вопроса для Заголовка
	СтрОбъект.Вставить("ВопросНаименование", СокрЛП(СтрОбъект.Вопрос.Наименование));
	
	// Переменная позволяет играть с разными часовыми поясами в одно и тоже время on-line 
	СтрОбъект.Вставить("ТекущаяДатаСеансаНаСервере", ТекущаяДатаСеанса());

	Возврат СтрОбъект;
	
КонецФункции	

&НаКлиенте
Процедура ДоступностьКнопок_СТАРТ_СТОП()
	
	// Видимость кнопок СТАРТ / STOP
	//
	Элементы.СтартИгры.Доступность = НЕ Объект.АктивныйХодИгры;
	Элементы.СтопИгры.Доступность  = Объект.АктивныйХодИгры;	
	
КонецПроцедуры	




// Команды (Игровой стол)

// СТАРТ>
&НаКлиенте
Процедура СтартСТекущейСтроки(Команда)
	
	Если ФормаДоступнаТолькоНаПросмотр Тогда
		ПоказатьПредупреждение(,"Только просмотр!");
		Возврат;
	КонецЕсли;	
	
	СтартИгрыВыборИзМеню(Новый Структура("Значение","С выбранной строки"), Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура СтартИгры(Команда)
	
	Если ФормаДоступнаТолькоНаПросмотр Тогда
		ПоказатьПредупреждение(,"Только просмотр!");
		Возврат;
	КонецЕсли;	
	
	// Вопрос о старте из выпадающего меню	
	Оповещение = Новый ОписаниеОповещения("СтартИгрыВыборИзМеню", ЭтотОбъект);
	Список = Новый СписокЗначений;
	Список.Добавить("С начала игры");
	Список.Добавить("С выбранной строки №"+АктивныйНомер);
	Список.Добавить("Продолжить играть");
	ПоказатьВыборИзМеню(Оповещение, Список, Элементы.СтартИгры);
	
КонецПроцедуры

&НаКлиенте
Процедура СтартИгрыВыборИзМеню(Результат, ДопПарам) Экспорт
	
	Если Результат<>Неопределено Тогда
		
		Если Результат.Значение="С начала игры" Тогда		
			АктивныйНомер = 1;
			ЗапускПроцедурыСтартНаСервере = Истина;			
		ИначеЕсли СтрНайти(Результат.Значение, "С выбранной строки")>0 Тогда
			// АктивныйНомер - установлен по текущей строке в обработчике события МаршрутИгрыПриАктивизацииСтроки
			ЗапускПроцедурыСтартНаСервере = Истина;
		ИначеЕсли Результат.Значение="Продолжить играть" Тогда
			ЗапускПроцедурыСтартНаСервере = Ложь;
		КонецЕсли;
		
		Если ЗапускПроцедурыСтартНаСервере Тогда
			
			Если ЕстьВозможностьЗаписиВРегистрМаршрутПроведенияИгры() Тогда
				СообщениеРезультат = СтартНаСервере();
				Блокировка_РегистрМаршрутаЗанят = ?(Блокировка_РегистрМаршрутаЗанят, Ложь, Истина);
				Если ЗначениеЗаполнено(СообщениеРезультат) Тогда 
					ПоказатьПредупреждение(,СообщениеРезультат);
				Иначе
					Объект.АктивныйХодИгры = Истина;
				КонецЕсли;
			Иначе
				ПоказатьПредупреждение(,"Отказано в доступе! Повторите попытку.");
			КонецЕсли;
			
		Иначе
			Объект.АктивныйХодИгры = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	ДоступностьКнопок_СТАРТ_СТОП();
	
КонецПроцедуры

&НаСервере
Функция СтартНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МаршрутПроведенияИгры.Игра КАК Игра,
	|	МаршрутПроведенияИгры.АктивныйВопрос КАК АктивныйВопрос,
	|	МаршрутПроведенияИгры.НомерСледования КАК НомерСледования,
	|	МаршрутПроведенияИгры.Вопрос КАК Вопрос,
	|	МаршрутПроведенияИгры.ДемонстрацияОтвета КАК ДемонстрацияОтвета,
	|	МаршрутПроведенияИгры.Длительность КАК Длительность,
	|	МаршрутПроведенияИгры.ВремяСтарта КАК ВремяСтарта,
	|	МаршрутПроведенияИгры.ВремяЗавершения КАК ВремяЗавершения,
	|	МаршрутПроведенияИгры.ВремяНачалаПаузы КАК ВремяНачалаПаузы,
	|	МаршрутПроведенияИгры.ВремяОкончанияПаузы КАК ВремяОкончанияПаузы
	|ИЗ
	|	РегистрСведений.МаршрутПроведенияИгры КАК МаршрутПроведенияИгры
	|ГДЕ
	|	(МаршрутПроведенияИгры.АктивныйВопрос
	|			ИЛИ МаршрутПроведенияИгры.НомерСледования = &НовыйНомерСледования)
	|	И МаршрутПроведенияИгры.Игра = &Игра";	
	Запрос.УстановитьПараметр("Игра", Объект.Игра);
	Запрос.УстановитьПараметр("НовыйНомерСледования", АктивныйНомер);
	
	СообщениеРезультат = "";
	
	Результат = Запрос.Выполнить();	
	Если Результат.Пустой() Тогда
		
		СообщениеРезультат = "     Нет задач!";
		
	Иначе	
		
		Выборка = Результат.Выбрать();	
		Пока Выборка.Следующий() Цикл
			
			// Обновление текущих записей без проверок (действие принудительное)		
			Запись = РегистрыСведений.МаршрутПроведенияИгры.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(Запись,Выборка,"Игра,АктивныйВопрос,НомерСледования");
			Запись.Прочитать();
			
			Если Запись.Выбран() Тогда		
				Запись.АктивныйВопрос = (Выборка.НомерСледования=АктивныйНомер); // Изменение активности записи		
				Если Запись.АктивныйВопрос Тогда // Обновляем данные старта
					Запись.ВремяСтарта = ТекущаяДатаСеанса();
					Запись.ВремяНачалаПаузы = Дата(1,1,1);
					Запись.ВремяОкончанияПаузы = Дата(1,1,1);
					Запись.Длительность = ?(ЗначениеЗаполнено(Запись.Длительность), Запись.Длительность, 60);
					Запись.ВремяЗавершения = Запись.ВремяСтарта + Запись.Длительность;
					
					// Наименование вопроса для Заголовка				
					ЗаполнитьЗначенияСвойств(Объект, Запись); // - Обновление данных формы после выполнения команды
					Объект.ВопросНаименование = СокрЛП(Запись.Вопрос.Наименование);
				КонецЕсли;		
				Запись.Записать(Истина);		
			КонецЕсли;	
			
		КонецЦикла;
		
	КонецЕсли;
	
	Элементы.МаршрутИгры.Обновить();
	
	Возврат СообщениеРезультат;
	
КонецФункции


