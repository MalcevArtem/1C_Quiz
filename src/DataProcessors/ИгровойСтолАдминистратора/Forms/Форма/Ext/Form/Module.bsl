				Если ТекущаяДатаСеанса<=Выборка.ВремяОкончанияПаузы Тогда // Т.е. сейчас идёт пауза
					Новое_ВремяОкончанияПаузы = Выборка.ВремяОкончанияПаузы  + ДлительностьДобавленногоВремени;
					Новое_ВремяЗавершения     = Выборка.ВремяЗавершения + ДлительностьДобавленногоВремени;											
				Иначе	
					Новое_ВремяОкончанияПаузы = Выборка.ВремяОкончанияПаузы;
					Новое_ВремяЗавершения     = Выборка.ВремяЗавершения + ДлительностьДобавленногоВремени;							
				КонецЕсли;
				
				// Обновление текущей записи		
				Запись = РегистрыСведений.МаршрутПроведенияИгры.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(Запись,Выборка,"Игра,АктивныйВопрос,НомерСледования");
				Запись.Прочитать();
				
				Если Запись.Выбран() Тогда	
					Запись.ВремяОкончанияПаузы = Новое_ВремяОкончанияПаузы;
					Запись.ВремяЗавершения     = Новое_ВремяЗавершения;				
					ЗаполнитьЗначенияСвойств(Объект, Запись); // Обновление данных формы после выполнения команды
					Запись.Записать(Истина);					
				КонецЕсли;	
				
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		СообщениеРезультат = "Нет активно выполнаемой задачи!";
	КонецЕсли;
	
	Элементы.МаршрутИгры.Обновить();
	
	Возврат СообщениеРезультат;
	
КонецФункции


// ОСТАВИТЬ ВРЕМЯ 
&НаКлиенте
Процедура ОставитьВремя(Команда)
	
	Если ФормаДоступнаТолькоНаПросмотр Тогда
		ПоказатьПредупреждение(,"Только просмотр!");
		Возврат;
	КонецЕсли;
	
	Если ЕстьВозможностьЗаписиВРегистрМаршрутПроведенияИгры() Тогда
		СообщениеРезультат = ОставитьВремяНаСервере();
		Блокировка_РегистрМаршрутаЗанят = ?(Блокировка_РегистрМаршрутаЗанят, Ложь, Истина);
		Если ЗначениеЗаполнено(СообщениеРезультат) Тогда ПоказатьПредупреждение(,СообщениеРезультат); КонецЕсли;
	Иначе
		ПоказатьПредупреждение(,"Отказано в доступе! Повторите попытку.");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ОставитьВремяНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	МаршрутПроведенияИгры.Игра КАК Игра,
	|	МаршрутПроведенияИгры.АктивныйВопрос КАК АктивныйВопрос,
	|	МаршрутПроведенияИгры.НомерСледования КАК НомерСледования,
	|	МаршрутПроведенияИгры.Вопрос КАК Вопрос,
	|	МаршрутПроведенияИгры.ДемонстрацияОтвета КАК ДемонстрацияОтвета,
	|	МаршрутПроведенияИгры.Длительность КАК Длительность,
	|	МаршрутПроведенияИгры.ВремяСтарта КАК ВремяСтарта,
	|	МаршрутПроведенияИгры.ВремяЗавершения КАК ВремяЗавершения,
	|	МаршрутПроведенияИгры.ВремяНачалаПаузы КАК ВремяНачалаПаузы,
	|	МаршрутПроведенияИгры.ВремяОкончанияПаузы КАК ВремяОкончанияПаузы
	|ИЗ
	|	РегистрСведений.МаршрутПроведенияИгры КАК МаршрутПроведенияИгры
	|ГДЕ
	|	МаршрутПроведенияИгры.АктивныйВопрос
	|	И МаршрутПроведенияИгры.Игра = &Игра
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСледования УБЫВ";	
	Запрос.УстановитьПараметр("Игра", Объект.Игра);
	
	СообщениеРезультат = "";
	
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		
		Выборка = Результат.Выбрать();	
		Пока Выборка.Следующий() Цикл
			
			ТекущаяДатаСеанса = ТекущаяДатаСеанса();
			
			Если ТекущаяДатаСеанса>=Выборка.ВремяЗавершения Тогда // уже проскачили по времени
				
				СообщениеРезультат = "Текущая задача уже не активна. Повторите попытку.";					
				
			Иначе
				
				Если ТекущаяДатаСеанса<=Выборка.ВремяОкончанияПаузы Тогда // Т.е. сейчас идёт пауза
					Новое_ВремяОкончанияПаузы = ТекущаяДатаСеанса + ДлительностьОставленногоВремени;
					Новое_ВремяЗавершения     = Выборка.ВремяЗавершения + (Новое_ВремяОкончанияПаузы - Выборка.ВремяОкончанияПаузы);											
				Иначе	
					Новое_ВремяОкончанияПаузы = Выборка.ВремяОкончанияПаузы;
					Новое_ВремяЗавершения     = ТекущаяДатаСеанса + ДлительностьОставленногоВремени;
				КонецЕсли;
				
				// Обновление текущей записи		
				Запись = РегистрыСведений.МаршрутПроведенияИгры.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(Запись,Выборка,"Игра,АктивныйВопрос,НомерСледования");
				Запись.Прочитать();
				
				Если Запись.Выбран() Тогда	
					Запись.ВремяОкончанияПаузы = Новое_ВремяОкончанияПаузы;
					Запись.ВремяЗавершения     = Новое_ВремяЗавершения;				
					ЗаполнитьЗначенияСвойств(Объект, Запись); // Обновление данных формы после выполнения команды
					Запись.Записать(Истина);					
				КонецЕсли;	
				
			КонецЕсли;		
			
		КонецЦикла;
		
	Иначе
		СообщениеРезультат = "Нет активно выполнаемой задачи!";
	КонецЕсли;
	
	Элементы.МаршрутИгры.Обновить();
	
	Возврат СообщениеРезультат;
	
КонецФункции




// Команды (Отчеты)
