Процедура ОбновитьАктивностьУчастников(Команда)
	ОбновитьАктивностьУчастниковНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОбновитьАктивностьУчастниковНаСервере()
	
	ДеревоУчастниковКоманд.ПолучитьЭлементы().Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИграСписокКоманд.Команда КАК Команда,
	|	ИграСписокКоманд.НомерСтроки КАК НомерКоманды
	|ПОМЕСТИТЬ Команды
	|ИЗ
	|	Документ.Игра.СписокКоманд КАК ИграСписокКоманд
	|ГДЕ
	|	ИграСписокКоманд.Ссылка = &Игра
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КомандыИгроки.Ссылка КАК Команда,
	|	Команды.НомерКоманды КАК НомерКоманды,
	|	КомандыИгроки.НомерСтроки КАК НомерИгрока,
	|	КомандыИгроки.Игрок КАК Игрок,
	|	КомандыИгроки.Игрок.Код КАК Имя
	|ИЗ
	|	Команды КАК Команды
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Команды.Игроки КАК КомандыИгроки
	|		ПО Команды.Команда = КомандыИгроки.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Команды.НомерКоманды,
	|	КомандыИгроки.НомерСтроки
	|ИТОГИ ПО
	|	Команда ИЕРАРХИЯ";	
	Запрос.УстановитьПараметр("Игра", Объект.Игра);
	
	// Получение списка активных пользователей
	МассивСоединений = ПолучитьСоединенияИнформационнойБазы();
	МассивИменПользователей = Новый Массив;
	Для Каждого Соединение Из МассивСоединений Цикл
		МассивИменПользователей.Добавить(Соединение.Пользователь.Имя);
	КонецЦикла;
	
	// Счетчики:
	КоличествоВсегоИгроков = 0;
	КоличествоПодключившихсяИгроков = 0;	
	
	// Вывод Дерева
	Результат = Запрос.Выполнить();
	ВыборкаКоманда = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);	
	Пока ВыборкаКоманда.Следующий() Цикл		
		
		СтрКоманда = ДеревоУчастниковКоманд.ПолучитьЭлементы().Добавить();
		СтрКоманда.КомандаИгрок = ВыборкаКоманда.Команда;
		СоставИгроков = СтрКоманда.ПолучитьЭлементы();	
		
		ВыборкаДетали = ВыборкаКоманда.Выбрать();
		КоличествоПодключившихсяИгроковИзКоманды = 0;
		НомерКоманды = "";
		Пока ВыборкаДетали.Следующий() Цикл		
			СтрИгрок = СоставИгроков.Добавить();
			СтрИгрок.КомандаИгрок = ВыборкаДетали.Игрок;
			СтрИгрок.Номер = Строка(ВыборкаДетали.НомерКоманды)+"." + Строка(ВыборкаДетали.НомерИгрока)+"."+?(ВыборкаДетали.НомерИгрока=1,".К","");
			НомерКоманды = Строка(ВыборкаДетали.НомерКоманды)+".";
			КоличествоВсегоИгроков = КоличествоВсегоИгроков + 1;
			Если МассивИменПользователей.Найти(ВыборкаДетали.Имя)<>Неопределено Тогда
				КоличествоПодключившихсяИгроковИзКоманды = КоличествоПодключившихсяИгроковИзКоманды + 1;
				СтрИгрок.Активен = Истина;
				КоличествоПодключившихсяИгроков = КоличествоПодключившихсяИгроков + 1;
			КонецЕсли;				
		КонецЦикла;		
		СтрКоманда.Номер = НомерКоманды;
		Если ВыборкаДетали.Количество()=КоличествоПодключившихсяИгроковИзКоманды Тогда
			СтрКоманда.Активен = Истина;
		КонецЕсли;		
		
	КонецЦикла;
	
	// Ждём:
	КоличествоЖдемИгроков = КоличествоВсегоИгроков - КоличествоПодключившихсяИгроков;
	
КонецПроцедуры




