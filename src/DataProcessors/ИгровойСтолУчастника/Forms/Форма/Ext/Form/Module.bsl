&НаКлиенте
Процедура ОтчетыВыборИзМеню(Результат, ДопПарам) Экспорт
	
	// Запуск выбранных команд но кнопке "Отчёты"
	//
	
	Если Результат<>Неопределено Тогда		
		Если Результат.Значение = "Рейтинг игроков" Тогда			
			РейтингИгроков(Неопределено);
		ИначеЕсли Результат.Значение = "Состав команд" Тогда
			ИгрокиКоманд(Неопределено);
		ИначеЕсли Результат.Значение = "Результат игры" Тогда
			ТекущийРезультатИгры(Неопределено);
		КонецЕсли;				
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура БыстрыйВводОтвета(Команда)
	
	// БЫСТРЫЙ ВВОД ОТВЕТА		
	Если Объект.ВидВопроса=ПредопределенноеЗначение("Перечисление.ВидВопроса.Тест") Тогда // ТЕСТ		
		Если НЕ Объект.ДемонстрацияОтвета Тогда 
			ОповещениеОВыбореИзСписка = Новый ОписаниеОповещения("ОтветыИгроковПередНачаломИзмененияВыборИзМеню", ЭтотОбъект);
			//ПоказатьВыборИзМеню(ОповещениеОВыбореИзСписка, Объект.ВариантыОтветовНаТест, Элементы.БыстрыйВводОтвета);	// - старая процедура		
			ОповещениеОВыбореИзСписка = Новый ОписаниеОповещения("ОтветыИгроковПередНачаломИзмененияВыборИзМеню", ЭтотОбъект);
			Парам = Новый Структура("ВариантыОтветовНаТест,Масштаб",Объект.ВариантыОтветовНаТест, Масштаб);
			ОткрытьФорму("Обработка.ИгровойСтолУчастника.Форма.БыстрыйВыборЗначенияТеста", Парам, ЭтаФорма, , , , ОповещениеОВыбореИзСписка, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);			 
		Иначе
			// Демонстрация ответа на тест
		КонецЕсли;		
	ИначеЕсли Объект.ВидВопроса=ПредопределенноеЗначение("Перечисление.ВидВопроса.ВопросСОтветом") Тогда // ТЕКСТОВЫЙ ВОПРОС
		Если НЕ Объект.ДемонстрацияОтвета Тогда 
			
			ТекстПодсказки = "ОТВЕТ";
			ТекущиеДанныеСтроки = ""; 
			ТекДанные = Элементы.ОтветыИгроков.ТекущиеДанные;			
			Если ТекДанные<>Неопределено Тогда
				Если Объект.ОтветыИгроков.Количество()>1 Тогда
					ТекстПодсказки = "ОТВЕТ №"+Строка(ТекДанные.НомерСтроки) + ?(Объект.ИспользоватьПредставление," "+СокрЛП(ТекДанные.Представление),"");			
				КонецЕсли;
				ТекущиеДанныеСтроки = ТекДанные["Ответ"+Строка(Объект.НомерИгрока)];
			КонецЕсли;	
			
			ОповещениеОБыстромВводеСтроки = Новый ОписаниеОповещения("ОтветыИгроковБыстрыйВводСтроки", ЭтотОбъект);
			//ПоказатьВводСтроки(ОповещениеОБыстромВводеСтроки, ТекущиеДанныеСтроки, ТекстПодсказки, , Истина);	// - старая процедура			
			Парам = Новый Структура("ТекстПодсказки,ТекущиеДанныеСтроки, Масштаб",ТекстПодсказки,ТекущиеДанныеСтроки, Масштаб);
			ОткрытьФорму("Обработка.ИгровойСтолУчастника.Форма.БыстрыйВыборТекста", Парам, ЭтаФорма, , , , ОповещениеОБыстромВводеСтроки);			
			ТекущийЭлемент = Элементы.ОтветыИгроков; // Устанавливаем активность поля ТЧ, чтобы избежать ошибки непроизвольного вызова Enter после события завершения редактирования поля текстового ответа
			
		Иначе
			// Демонстрация ответа на тестовый вопрос
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

