// Обработчики событий общие
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
			
	// БЛОКИРОВКА
	СтрБлокировка = ИгровойСерверПривилегированный.ПолучитьЗначениеБлокировкиТекущегоПользователя();		
	Если ЗначениеЗаполнено(СтрБлокировка.ВремяЗавершенияБлокировки) И НЕ СтрБлокировка.РазрещенаРабота Тогда
		Сообщить("Администратор не разрешает работу в программе до "+Строка(СтрБлокировка.ВремяЗавершенияБлокировки));
		Отказ = Истина;
	КонецЕсли;	
	
		
	// КНОПКА: ОТЧЕТЫ
	СписокКнопокОтчеты.Очистить();
	СписокКнопокОтчеты.Добавить("Рейтинг игроков");
	СписокКнопокОтчеты.Добавить("Состав команд");
	СписокКнопокОтчеты.Добавить("Результат игры");
	
	
	// ИНФОРМАЦИЯ ОБ ЭКРАНАХ КЛИЕНТА:  {Эмпирический расчет}
	МассивЭкрановКлиента = ПолучитьИнформациюЭкрановКлиента();
	Если МассивЭкрановКлиента.Количество()>0 Тогда		
		ВысотаОсновногоЭкрана = МассивЭкрановКлиента[0].Высота;	// - высота основного экрана
		Если ВысотаОсновногоЭкрана>=1200 Тогда
			РасчетнаяВысотаТЧОтветыИгроков = 10;
		ИначеЕсли ВысотаОсновногоЭкрана>=1000 Тогда 	
			РасчетнаяВысотаТЧОтветыИгроков = 7;
		ИначеЕсли ВысотаОсновногоЭкрана>=900 Тогда 	
			РасчетнаяВысотаТЧОтветыИгроков = 5;	
		ИначеЕсли ВысотаОсновногоЭкрана>=800 Тогда 	
			РасчетнаяВысотаТЧОтветыИгроков = 4;
		Иначе	
			РасчетнаяВысотаТЧОтветыИгроков = 3;
		КонецЕсли;
	Иначе
		РасчетнаяВысотаТЧОтветыИгроков = 10;
	КонецЕсли;
	
	
	// При открытии обработки из элемента справочника "Вопросы"
	Параметры.Свойство("РежимДемонстрационногоПросмотраВопроса", РежимДемонстрационногоПросмотраВопроса);	
	Если НЕ РежимДемонстрационногоПросмотраВопроса Тогда
				
		// СТАТИЧЕСКИЕ ДАННЫЕ
		//
		// Получить Текущую игру
		Объект.Игра = Константы.ТекущаяИгра.Получить();
		//
		// Получить Текущего игрока
		Объект.Игрок = ПараметрыСеанса.ТекущийПользователь;		
		
		
		// Время Обновления данных игроков:
		ВремяОбновленияДанныхИгрока = Константы.ВремяОбновленияДанныхИгрока.Получить();
		Если ВремяОбновленияДанныхИгрока=0 Тогда
			ВремяОбновленияДанныхИгрока = 3;
		КонецЕсли;
		
		// Заполнение данных по всем вопросам текущего маршрута игры:
		Объект.ДанныеВопросовТекущейИгры = ИгровойСерверПривилегированный.ПолучитьДанныеВопросовИзМаршрутаТекущейИгры();
		
		
		// ДИНАМИЧЕСКИЕ ДАННЫЕ
		Если ЗначениеЗаполнено(Объект.Игра) И ЗначениеЗаполнено(Объект.Игрок) Тогда			
			
			// Получение данных всех игроков команды, заполнение команды и номера текущего игрока
			ТЗ_ДанныеИгроков = ИгровойСерверПривилегированный.ПолучитьДанныеКомандыИгрока(Объект.Игра, Объект.Игрок);	
			Если ТЗ_ДанныеИгроков.Количество()>0 Тогда // Заполнняем данные настройки колонок ТЧ
				
				// Заполнить Номер текущего игрока:
				Объект.НомерИгрока = ТЗ_ДанныеИгроков.Получить(0).НомерТекущегоИгрока;
				
				// Заполнить Номер текущего игрока:
				Объект.Команда = ТЗ_ДанныеИгроков.Получить(0).Команда;
				
				// Заполнение настроек в ТЧ команды
				Для Каждого КолонкаТЧ Из Элементы.ОтветыИгроков.ПодчиненныеЭлементы Цикл	
					Если СтрНайти(КолонкаТЧ.Имя,"ОтветыИгроковОтвет")>0 Тогда		
						НомерКолонки = Число(СтрЗаменить(КолонкаТЧ.Имя,"ОтветыИгроковОтвет",""));	
						Отбор = Новый Структура("НомерИгрока", НомерКолонки);
						МассивСтрок = ТЗ_ДанныеИгроков.НайтиСтроки(Отбор);
						Если МассивСтрок.Количество()>0 Тогда
							КолонкаТЧ.Заголовок = СокрЛП(МассивСтрок[0].ИгрокНаименование) + ?(НомерКолонки=1," [Капитан]","");
							КолонкаТЧ.Видимость = Истина;				
							Если НомерКолонки=1 Тогда
								КолонкаТЧ.ЦветТекстаЗаголовка = WebЦвета.Синий;  // Капитан
							ИначеЕсли Объект.НомерИгрока=НомерКолонки Тогда
								КолонкаТЧ.ЦветТекстаЗаголовка = WebЦвета.ТемноФиолетовый; // Для себя увеличим видимость
							Иначе
								КолонкаТЧ.ЦветТекстаЗаголовка = WebЦвета.Черный; // Остальные
							КонецЕсли;			
						Иначе                           
							КолонкаТЧ.Видимость = Ложь;
						КонецЕсли;
						Если НомерКолонки<>Объект.НомерИгрока Тогда
							КолонкаТЧ.РедактированиеТекста = Ложь;  // запрет редактирование текста в других колонках
							КолонкаТЧ.Подсказка = "Колонка с ответом другого игрока команды";
						Иначе
							КолонкаТЧ.Подсказка = "Колонка для ввода Вашего ответа";
							КолонкаТЧ.ПодсказкаВвода = "Введите ответ";
						КонецЕсли;	
					Иначе
						КолонкаТЧ.ТолькоПросмотр = Истина;
					КонецЕсли;				
				КонецЦикла;
				
			КонецЕсли;	
			
			Если Объект.НомерИгрока>0 Тогда // Отрисовываем данные если игрок обнаружен в игре:
				
				// Игрок должен видеть свою колонку как самую левую:
				Элементы.Переместить(Элементы["ОтветыИгроковОтвет"+Строка(Объект.НомерИгрока)], Элементы.ОтветыИгроков, Элементы.ОтветыИгроковПредставление);
				
				
				// Подсказка ТЧ.ОтветыИгроков
				Элементы.ОтветыИгроков.Подсказка = "Ввод ответа вручную осуществляется в своей колонке """ + Строка(ПараметрыСеанса.ТекущийПользователь)+"""" + Символы.ПС + 
				"Или нажатием на кнопку ""ОТВЕТ"" (Ctrl+Enter)";
				Если Объект.НомерИгрока = 1 Тогда
					Элементы.ОтветыИгроков.Подсказка = Элементы.ОтветыИгроков.Подсказка + Символы.ПС +Символы.ПС + 
					"Скопировать ответ игрока: нажать два раза левой кнопкой мышки";			
				КонецЕсли;		
				
				// Получение данных во выполнению текущего маршрута выполнения вопроса и ответов пользователей
				Объект.Вопрос = Справочники.Вопросы.ПустаяСсылка();
				Объект.НеСчитыватьОтветыИгроков = Ложь;
				Объект.ВремяПоследнегоОбновления = '00010101';
				СтрВопрос = ПолучитьДанныеТекущегоВопросаИОтветовИгроков(Объект.Игра, Объект.Вопрос, Объект.НеСчитыватьОтветыИгроков, Объект.Команда, Объект.ВремяПоследнегоОбновления);
				ЗаполнитьЗначенияСвойств(Объект, СтрВопрос);  // Заполнение реквизитов маршрута	
				ОбновитьДанные_Вопрос(Истина, СтрВопрос.МассивДанныхИгроков); // Заполнение реквизитов вопроса
				
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		// Реквизиты просморта вопроса
		Объект.Вопрос = Параметры.Вопрос;
		Объект.ДемонстрацияОтвета = Параметры.ДемонстрацияОтвета;
		
		// Интерфейсные - для красоты просмотра
		Объект.НомерИгрока = 1;
		Элементы.Переместить(Элементы["ОтветыИгроковОтвет"+Строка(Объект.НомерИгрока)], Элементы.ОтветыИгроков, Элементы.ОтветыИгроковПредставление);
		Элементы["ОтветыИгроковОтвет"+Строка(Объект.НомерИгрока)].Заголовок = ПараметрыСеанса.ТекущийПользователь;
		
		// Пустое:
		МассивИндексВопросов = Новый Массив;
		МассивИндексВопросов.Добавить(Неопределено); 
		МассивИндексВопросов.Добавить(Справочники.Вопросы.ПустаяСсылка());
		МассивДанных = Новый Массив;
		МассивДанных.Добавить(МассивИндексВопросов);		
		Объект.ДанныеВопросовТекущейИгры = Новый Структура("МассивДанных",МассивДанных);
		
		// Заполнение данных вопроса
		ОбновитьДанные_Вопрос(Истина, Новый Массив);
		
	КонецЕсли;
	
	// Для Отладки вопроса при Демонстрации
	ЕстьПраваНаОтладку = РольДоступна("ПолныеПрава") ИЛИ Константы.АдминистраторИгры.Получить()=ПараметрыСеанса.ТекущийПользователь;
	Элементы.ОткрытьВопрос.Видимость   = ЕстьПраваНаОтладку;
	Элементы.ОткрытьВопрос.Доступность = ЕстьПраваНаОтладку;
	
	
	// Переменная запоняется при запуске игрового стола и позволяет играть с разными часовыми поясами
	// в одно и тоже время on-line 
	Объект.ТекущаяДатаСеансаНаСервере = ТекущаяДатаСеанса();                             
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// При открытии обработки из элемента справочника "Вопросы"
	Если РежимДемонстрационногоПросмотраВопроса Тогда Возврат; КонецЕсли;
	
	// Переменная запоняется при запуске игрового стола и позволяет играть с разными часовыми поясами
	// в одно и тоже время on-line 
	Объект.СинхронизацияСВременемСервера = Объект.ТекущаяДатаСеансаНаСервере - ТекущаяДата();	
	
	// Критическая проверка на возможность дпльнейшей игры
	Если НЕ ЗначениеЗаполнено(Объект.Игра) Тогда
		ПоказатьПредупреждение(,"Игра ещё на началась!");
		Отказ = Истина;
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.Игрок) Тогда
		ПоказатьПредупреждение(,"В параметрах сеанса не определён игрок!");
		Отказ = Истина;
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.Команда) Тогда
		ПоказатьПредупреждение(,"Пользователь с именем "+Строка(Объект.Игрок)+" не введен ни в одну из учавствующих команд!");
		Отказ = Истина;
	КонецЕсли;
	
	Если Отказ Тогда Возврат; КонецЕсли;	
	
	// При обновлении данных формы:
	Масштаб = 100;
	
	// СТАРТ: счетчика Времени
	ПодключитьОбработчикОжидания("ОбновитьЭлементы_ОперативныйСчетчикВремени", 0.3, Истина);
	
	// СТАРТ: обновления игровых данных из базы
	ПодключитьОбработчикОжидания("ОбновитьДанные_ХодИгры", ВремяОбновленияДанныхИгрока);	
	
КонецПроцедуры



// Обработчики событий формы
&НаКлиенте
Процедура ОтветыИгроковПередНачаломИзменения(Элемент, Отказ)
	
	Если СтрНайти(Элемент.ТекущийЭлемент.Имя,"ОтветыИгроковОтвет")>0 Тогда
		
		НомерКолонкиОткуда = Число(СтрЗаменить(Элемент.ТекущийЭлемент.Имя, "ОтветыИгроковОтвет",""));
		Если Объект.НомерИгрока=НомерКолонкиОткуда Тогда 
			
			Если Объект.ВариантыОтветовНаТест.Количество()>0 Тогда // Выбор из списка (тест)
				Отказ = Истина;
				ОповещениеОВыбореИзСписка = Новый ОписаниеОповещения("ОтветыИгроковПередНачаломИзмененияВыборИзМеню", ЭтотОбъект);
				ПоказатьВыборИзМеню(ОповещениеОВыбореИзСписка, Объект.ВариантыОтветовНаТест, Элемент);				
			Иначе
				// Это ввод текста вручную ...
			КонецЕсли;
			
		Иначе
			
			Если Объект.НомерИгрока=1 Тогда // капитан команды может копировать себе в ответ данные
				СкопированноеЗначение = Элементы.ОтветыИгроков.ТекущиеДанные["Ответ"+Строка(НомерКолонкиОткуда)];				
				Если ЗначениеЗаполнено(СкопированноеЗначение) Тогда
					ТекДанные = Элементы.ОтветыИгроков.ТекущиеДанные;
					Если ТекДанные<>Неопределено Тогда
						// Помещение в свою ячейку
						ТекДанные["Ответ"+Строка(Объект.НомерИгрока)] = СкопированноеЗначение;
						// Запись ответа в регистр ОтветыИгроков
						ИгровойСерверПривилегированный.ОтправитьДанныеОтветаИгрока(Объект.Игра, Объект.Вопрос, Объект.Команда, ТекДанные.НомерСтроки, Объект.НомерИгрока, Объект.Игрок, СкопированноеЗначение);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Отказ = Истина;			
		КонецЕсли;		
	Иначе
		Отказ = Истина;		
	КонецЕсли;
	
КонецПроцедуры   

&НаКлиенте
Процедура ОтветыИгроковПередНачаломИзмененияВыборИзМеню(Результат, ДопПарам) Экспорт
	
	// Обработка результата выбора из списка для теста
	Если НЕ Объект.ДемонстрацияОтвета И Объект.ВидВопроса=ПредопределенноеЗначение("Перечисление.ВидВопроса.Тест") Тогда
		Если Результат<>Неопределено Тогда
			ТекДанные = Элементы.ОтветыИгроков.ТекущиеДанные;
			Если ТекДанные<>Неопределено Тогда
				ТекДанные["Ответ"+Строка(Объект.НомерИгрока)] = Результат.Значение;
				ИгровойСерверПривилегированный.ОтправитьДанныеОтветаИгрока(Объект.Игра, Объект.Вопрос, Объект.Команда, ТекДанные.НомерСтроки, Объект.НомерИгрока, Объект.Игрок, Результат.Значение);			
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтветыИгроковБыстрыйВводСтроки(Результат, ДопПарам) Экспорт
	
	// Обработка результата ответа текстового вопроса
	Если НЕ Объект.ДемонстрацияОтвета И Объект.ВидВопроса=ПредопределенноеЗначение("Перечисление.ВидВопроса.ВопросСОтветом") Тогда
		Если Результат<>Неопределено Тогда
			ТекДанные = Элементы.ОтветыИгроков.ТекущиеДанные;
			Если ТекДанные<>Неопределено Тогда
				
				ТекДанные["Ответ"+Строка(Объект.НомерИгрока)] = Результат;
				ИгровойСерверПривилегированный.ОтправитьДанныеОтветаИгрока(Объект.Игра, Объект.Вопрос, Объект.Команда, ТекДанные.НомерСтроки, Объект.НомерИгрока, Объект.Игрок, Результат);				
				
				// Для множественных ответов после ввода строки передвигаем курсор на одну позицию вниз
				КоличествоОтветов = Объект.ОтветыИгроков.Количество();
				Если КоличествоОтветов>1 Тогда 
					ИдентификаторСтроки = Элементы.ОтветыИгроков.ТекущаяСтрока;
					Если ТипЗнч(ИдентификаторСтроки)=Тип("Число") Тогда // условие найденной строки
						Элементы.ОтветыИгроков.ТекущаяСтрока = ИдентификаторСтроки + 1;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтветыИгроковПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ОтветыИгроковПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ОтветыИгроковПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	// Отправка данных ответа после редактирования в своей ячейке
	ТекЭлемент = Элементы.ОтветыИгроков.ТекущийЭлемент;
	Если ТекЭлемент<>Неопределено И ТекЭлемент.Имя="ОтветыИгроковОтвет"+Строка(Объект.НомерИгрока) Тогда		
		ТекДанные = Элементы.ОтветыИгроков.ТекущиеДанные;
		Если ТекДанные<>Неопределено Тогда
			// Запись ответа в регистр ОтветыИгроков
			ИгровойСерверПривилегированный.ОтправитьДанныеОтветаИгрока(Объект.Игра, Объект.Вопрос, Объект.Команда, ТекДанные.НомерСтроки, Объект.НомерИгрока, Объект.Игрок, ТекДанные["Ответ"+Строка(Объект.НомерИгрока)]); 
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры               

