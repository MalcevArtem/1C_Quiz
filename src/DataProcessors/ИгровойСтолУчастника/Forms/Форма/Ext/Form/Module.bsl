




// Процедуры и функции обновлений
&НаСервереБезКонтекста
Функция ПолучитьДанныеТекущегоВопросаИОтветовИгроков(Игра, Вопрос, НеСчитыватьОтветыИгроков, Команда, ВремяПоследнегоОбновления)
	
	// ОПТИМИЗАЦИЯ
	//
	
	// Текущий вопрос:
	СтрВопрос = ИгровойСерверПривилегированный.ПолучитьДанныеТекущегоВопроса(Игра);
	
	// Считывание данных ответов ироков:
	Если СтрВопрос.Вопрос<>Вопрос Тогда 		
		ВремяСчитыванияДанных = '00010101'; // загрузка вопроса, поэтому ответы за весь период
		МассивДанныхИгроков = ИгровойСерверПривилегированный.ПолучитьДанныеОтветовДругихИгроковКоманды(Игра, СтрВопрос.Вопрос, Команда, ВремяСчитыванияДанных); // Запрос данных игроков по текущему вопросу	
	Иначе			
		Если НеСчитыватьОтветыИгроков Тогда
			МассивДанныхИгроков = Новый Массив;
		Иначе
			ВремяСчитыванияДанных = ВремяПоследнегоОбновления - 3; // 3 секунды отнимаем на всякий случай, погрешность синхронизации данных
			МассивДанныхИгроков = ИгровойСерверПривилегированный.ПолучитьДанныеОтветовДругихИгроковКоманды(Игра, СтрВопрос.Вопрос, Команда, ВремяСчитыванияДанных); // Запрос данных игроков по текущему вопросу
		КонецЕсли;	
	КонецЕсли;
	СтрВопрос.Вставить("МассивДанныхИгроков", МассивДанныхИгроков);
	
	
	// Время последнего обновления
	ВремяПоследнегоОбновления = ТекущаяДатаСеанса();
	
	// Переменная позволяет играть с разными часовыми поясами в одно и тоже время on-line 
	СтрВопрос.Вставить("ТекущаяДатаСеансаНаСервере", ТекущаяДатаСеанса());
	
	Возврат СтрВопрос;
	
КонецФункции	

&НаКлиенте
Процедура ОбновитьДанные_ОтветыИгроковНаКлиенте(МассивДанныхИгроков, ДанныеВсехИгроков)
	
	КоличествоСтр = МассивДанныхИгроков.Количество();	
	Если КоличествоСтр>0 Тогда // Проверка наличия данных
		
		// Перебираем цикл строк ТЧ  
		Для Каждого СтрТЧ Из Объект.ОтветыИгроков Цикл
			
			Если СтрТЧ.НомерСтроки>КоличествоСтр Тогда Прервать; КонецЕсли; // - далее нет данных
			
			ДанныеПо1Строке = МассивДанныхИгроков.Получить(СтрТЧ.НомерСтроки-1); // - получение массива данных по каждому игроку
			Если ДанныеПо1Строке<>Неопределено Тогда // - проверка наличия данных в этой строке  
				
				// Перебираем данные одной строки и обновляем их на форме ТЧ
				НомерИгрока = 0;
				Для Каждого ЭлИгрок Из ДанныеПо1Строке Цикл	
					НомерИгрока = НомерИгрока + 1;
					Если ЭлИгрок<>Неопределено Тогда					
						// Обновляем если параметр ОбновитьВсеДанные=Истина ИЛИ не колонка самого игрока
						Если ДанныеВсехИгроков ИЛИ НомерИгрока<>Объект.НомерИгрока Тогда
							СтрТЧ["Ответ"+Строка(НомерИгрока)] = ЭлИгрок;
						КонецЕсли;					
					КонецЕсли;					
				КонецЦикла;		
				
			КонецЕсли;		
			
		КонецЦикла;	
		
	КонецЕсли;		
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанные_ОтветыИгроковНаСервере(МассивДанныхИгроков, ДанныеВсехИгроков)
	
	КоличествоСтр = МассивДанныхИгроков.Количество();	
	Если КоличествоСтр>0 Тогда // Проверка наличия данных
		
		// Перебираем цикл строк ТЧ  
		Для Каждого СтрТЧ Из Объект.ОтветыИгроков Цикл
			
			Если СтрТЧ.НомерСтроки>КоличествоСтр Тогда Прервать; КонецЕсли; // - далее нет данных
			
			ДанныеПо1Строке = МассивДанныхИгроков.Получить(СтрТЧ.НомерСтроки-1); // - получение массива данных по каждому игроку
			Если ДанныеПо1Строке<>Неопределено Тогда // - проверка наличия данных в этой строке  
				
				// Перебираем данные одной строки и обновляем их на форме ТЧ
				НомерИгрока = 0;
				Для Каждого ЭлИгрок Из ДанныеПо1Строке Цикл	
					НомерИгрока = НомерИгрока + 1;
					Если ЭлИгрок<>Неопределено Тогда					
						// Обновляем если параметр ОбновитьВсеДанные=Истина ИЛИ не колонка самого игрока
						Если ДанныеВсехИгроков ИЛИ НомерИгрока<>Объект.НомерИгрока Тогда
							СтрТЧ["Ответ"+Строка(НомерИгрока)] = ЭлИгрок;
						КонецЕсли;					
					КонецЕсли;					
				КонецЦикла;		
				
			КонецЕсли;		
			
		КонецЦикла;	
		
	КонецЕсли;		
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанные_Вопрос(ИзменениеВопроса, МассивДанныхИгроков)
	
	// ОПТИМИЗАЦИЯ
	//
	// Обновление данных вопроса
	//
	Если ИзменениеВопроса Тогда
		
		// Получение вопроса:
		НомерВопросаВОперативномХранилище = Объект.ДанныеВопросовТекущейИгры.МассивДанных[0].Найти(Объект.Вопрос);
		Если НомерВопросаВОперативномХранилище<>Неопределено Тогда
			СтрВопрос = Объект.ДанныеВопросовТекущейИгры.МассивДанных[НомерВопросаВОперативномХранилище];
		Иначе // Если новый и его не было в маршруте на момент открытия формы
			СтрВопрос = ИгровойСерверПривилегированный.ПолучитьСтруктуруВопроса(Объект.Вопрос);
		КонецЕсли;
		
		// Обновление реквизитов вопроса:
		ЗаполнитьЗначенияСвойств(Объект, СтрВопрос);
		
		// Структура ответов игроков:
		Объект.ОтветыИгроков.Очистить();
		Для Каждого ЭлОтвет Из СтрВопрос.ТЧОтветыИгроков Цикл
			ЗаполнитьЗначенияСвойств(Объект.ОтветыИгроков.Добавить(), ЭлОтвет);
		КонецЦикла;
		
		// Изображение вопроса. К сожалению только на &Cервере  :(
		Если Объект.ДемонстрацияОтвета И Объект.ИспользуетсяДемонстрацияОтвета Тогда
			Если Объект.ВидДанныхОтображенияДемонстрацияОтвета = ПредопределенноеЗначение("Перечисление.ВидДанныхОтображения.HTML") Тогда
				HTML = ИгровойСерверПривилегированный.ПолучитьПутьURLКорректировочный(Объект.ДанныеHTMLДемонстрацияОтвета); 
			Иначе	
				Объект.ДанныеФорматированныйДокумент = Объект.Вопрос.ДанныеФорматированныйДокументДемонстрацияОтвета.Получить();
			КонецЕсли;
		Иначе
			Если Объект.ВидДанныхОтображения = ПредопределенноеЗначение("Перечисление.ВидДанныхОтображения.HTML") Тогда
				HTML = ИгровойСерверПривилегированный.ПолучитьПутьURLКорректировочный(Объект.ДанныеHTML); 
			Иначе
				Объект.ДанныеФорматированныйДокумент = Объект.Вопрос.ДанныеФорматированныйДокумент.Получить();
			КонецЕсли;
		КонецЕсли;	
		
	Иначе                    
		
		// Изменился только параметр "ДемонстрацияОтвета"
		Если Объект.ИспользуетсяДемонстрацияОтвета Тогда		
			Если Объект.ДемонстрацияОтвета Тогда
				Если Объект.ВидДанныхОтображенияДемонстрацияОтвета = ПредопределенноеЗначение("Перечисление.ВидДанныхОтображения.HTML") Тогда
					HTML = ИгровойСерверПривилегированный.ПолучитьПутьURLКорректировочный(Объект.ДанныеHTMLДемонстрацияОтвета); 
				Иначе
					Объект.ДанныеФорматированныйДокумент = Объект.Вопрос.ДанныеФорматированныйДокументДемонстрацияОтвета.Получить();
				КонецЕсли;	
			Иначе
				Если Объект.ВидДанныхОтображения = ПредопределенноеЗначение("Перечисление.ВидДанныхОтображения.HTML") Тогда
					HTML = ИгровойСерверПривилегированный.ПолучитьПутьURLКорректировочный(Объект.ДанныеHTML); 
				Иначе
					Объект.ДанныеФорматированныйДокумент = Объект.Вопрос.ДанныеФорматированныйДокумент.Получить();
				КонецЕсли;	
			КонецЕсли;
		Иначе
			// Ничего не делаем. т.к. всего одно изображение и оно не меняется
		КонецЕсли;	
		
	КонецЕсли;
	
	
	// Флаг позволяет не делать лишний запрос на считвание данных ответов других игроков
	Объект.НеСчитыватьОтветыИгроков = Объект.ДемонстрацияОтвета ИЛИ Объект.ВидВопроса=ПредопределенноеЗначение("Перечисление.ВидВопроса.Заставка");
	//
	
	// Обновление данныех по вводу ответов от других игроков
	ОбновитьДанные_ОтветыИгроковНаСервере(МассивДанныхИгроков, ИзменениеВопроса);	
	
	// Обновление видимости и доступности элементов управления в завичимости от данных:
	ОбновитьЭлементы_ВидимостьДоступностьПолейРедактированияНаСервере();
	
КонецПроцедуры	

&НаКлиенте
Процедура ОбновитьЭлементы_ВидимостьДоступностьПолейРедактированияНаКлиенте()
	
	// Обновление видимости и доступности элементов управления в завичимости от данных:
	//
	
	//Идёт Пауза
	ЭтоПауза = (ТекущаяДата() + Объект.СинхронизацияСВременемСервера <= Объект.ВремяОкончанияПаузы);	
	
	Если Объект.ВидВопроса=ПредопределенноеЗначение("Перечисление.ВидВопроса.Тест") ИЛИ Объект.ВидВопроса=ПредопределенноеЗначение("Перечисление.ВидВопроса.ВопросСОтветом") Тогда				
		
		Элементы.Группа_Данные.Видимость                 = Объект.ДемонстрацияОтвета ИЛИ Не ЭтоПауза;
		Элементы.ОтветыИгроков.Видимость                 = Объект.ДемонстрацияОтвета ИЛИ Не ЭтоПауза;
		Элементы.ОтветыИгроков.ТолькоПросмотр            = Объект.ДемонстрацияОтвета;
		//Элементы.ОтветыИгроковПравильныйОтвет.Видимость  = Объект.ДемонстрацияОтвета И НЕ Объект.ИспользуетсяДемонстрацияОтвета;	
		Элементы.ОтветыИгроковПравильныйОтвет.Видимость  = Объект.ДемонстрацияОтвета;
		
		// Подстройка под высоту экрана игрока:
		КоличествоЭлементовТЧ = Объект.ОтветыИгроков.Количество();
		Если РасчетнаяВысотаТЧОтветыИгроков>0 Тогда
			КоличествоЭлементовТЧ=МИН(КоличествоЭлементовТЧ,РасчетнаяВысотаТЧОтветыИгроков); 
		КонецЕсли;		
		Элементы.ОтветыИгроков.Высота = КоличествоЭлементовТЧ + 2; // Высота таблицы ответов		
		Элементы.ОтветыИгроковНомерСтроки.Видимость = ?(КоличествоЭлементовТЧ=1, Ложь, Истина);
		Элементы.ОтветыИгроковПредставление.Видимость = Объект.ИспользоватьПредставление;
		
	Иначе // Заголовок	
		
		Элементы.Группа_Данные.Видимость = Истина;
		Элементы.ОтветыИгроков.Видимость = Ложь;
		
	КонецЕсли;		
	
	// Видимость: ФорматируемыйДокумент / HTML
	ДемонстрацияОтвета = ?((Объект.ДемонстрацияОтвета И Объект.ИспользуетсяДемонстрацияОтвета), "ДемонстрацияОтвета", "");
	Если Объект["ВидДанныхОтображения"+ДемонстрацияОтвета] = ПредопределенноеЗначение("Перечисление.ВидДанныхОтображения.HTML") Тогда
		Элементы.HTML.Видимость = Истина;
		Элементы.ФорматированныйДокумент.Видимость = Ложь;
	Иначе
		Элементы.HTML.Видимость = Ложь;
		Элементы.ФорматированныйДокумент.Видимость = Истина;
	КонецЕсли;	

КонецПроцедуры

&НаСервере
Процедура ОбновитьЭлементы_ВидимостьДоступностьПолейРедактированияНаСервере()
	
	// Обновление видимости и доступности элементов управления в завичимости от данных:
	//
	
	//Идёт Пауза
	ЭтоПауза = (ТекущаяДата() + Объект.СинхронизацияСВременемСервера <= Объект.ВремяОкончанияПаузы);	
	
	Если Объект.ВидВопроса=ПредопределенноеЗначение("Перечисление.ВидВопроса.Тест") ИЛИ Объект.ВидВопроса=ПредопределенноеЗначение("Перечисление.ВидВопроса.ВопросСОтветом") Тогда				
		
		Элементы.Группа_Данные.Видимость                 = Объект.ДемонстрацияОтвета ИЛИ Не ЭтоПауза;
		Элементы.ОтветыИгроков.Видимость                 = Объект.ДемонстрацияОтвета ИЛИ Не ЭтоПауза;
		Элементы.ОтветыИгроков.ТолькоПросмотр            = Объект.ДемонстрацияОтвета;
		//Элементы.ОтветыИгроковПравильныйОтвет.Видимость  = Объект.ДемонстрацияОтвета И НЕ Объект.ИспользуетсяДемонстрацияОтвета;	
		Элементы.ОтветыИгроковПравильныйОтвет.Видимость  = Объект.ДемонстрацияОтвета;
		
		КоличествоЭлементовТЧ = Объект.ОтветыИгроков.Количество();
		// Подстройка под высоту экрана игрока:
		КоличествоЭлементовТЧ = Объект.ОтветыИгроков.Количество();
		Если РасчетнаяВысотаТЧОтветыИгроков>0 Тогда
			КоличествоЭлементовТЧ=МИН(КоличествоЭлементовТЧ,РасчетнаяВысотаТЧОтветыИгроков); 
		КонецЕсли;
		Элементы.ОтветыИгроков.Высота = КоличествоЭлементовТЧ + 2; // Высота таблицы ответов		
		Элементы.ОтветыИгроковНомерСтроки.Видимость = ?(КоличествоЭлементовТЧ=1, Ложь, Истина);
		Элементы.ОтветыИгроковПредставление.Видимость = Объект.ИспользоватьПредставление;
		
	Иначе // Заголовок	
		               
		Элементы.Группа_Данные.Видимость = Истина;
		Элементы.ОтветыИгроков.Видимость = Ложь;
		
	КонецЕсли;
	                  
	// Видимость: ФорматируемыйДокумент / HTML
	ДемонстрацияОтвета = ?((Объект.ДемонстрацияОтвета И Объект.ИспользуетсяДемонстрацияОтвета), "ДемонстрацияОтвета", "");
	Если Объект["ВидДанныхОтображения"+ДемонстрацияОтвета] = ПредопределенноеЗначение("Перечисление.ВидДанныхОтображения.HTML") Тогда
		Элементы.HTML.Видимость = Истина;
		Элементы.ФорматированныйДокумент.Видимость = Ложь;
	Иначе
		Элементы.HTML.Видимость = Ложь;
		Элементы.ФорматированныйДокумент.Видимость = Истина;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте          
Процедура ОбновитьЭлементы_ОперативныйСчетчикВремени()
	
	ВремяНаСервере = ТекущаяДата() + Объект.СинхронизацияСВременемСервера;	
	
	Если ВремяНаСервере<Объект.ВремяОкончанияПаузы Тогда
		
		ТекстИнформация_ПаузаИгра = "<Пауза>";
		ВремяСекунд = МАКС(Объект.ВремяОкончанияПаузы-ВремяНаСервере,0);	
		
	Иначе 	
		
		ВремяСекунд = МАКС(Объект.ВремяЗавершения-ВремяНаСервере,0);
		
		Если ВремяНаСервере<Объект.ВремяЗавершения Тогда // еще не истекло время			
			ТекстИнформация_ПаузаИгра = "";   // Игра					
		Иначе
			
			// время истекло а вопрос не сменился			
			Если ВремяНаСервере<Объект.ВремяЗавершения+10 Тогда
				ТекстИнформация_ПаузаИгра = "";   // Игра
			Иначе			
				ТекстИнформация_ПаузаИгра = "Игра остановлена";
			КонецЕсли;	
			
			Если ВремяОбновленияДанныхИгрока>3 И ВремяНаСервере=Объект.ВремяЗавершения+2 И Объект.ВремяПоследнегоОбновления+1<ВремяНаСервере Тогда // 2-я секунда при истечении времени вопроса
				ОбновитьДанные_ХодИгры(); // Оперативное обновление, если очень большое значение Константы.ВремяОбновленияДанныхИгрока, т.е. много активных игрокове
			КонецЕсли;                                                                  
			
		КонецЕсли;
		
	КонецЕсли;		
	
	Информация_Время = ИгровойКлиент.ПолучитьВремяВЧасахМинутахИСекундах(ВремяСекунд); // Переводим в минуты
	
	Заголовок = ?(ПустаяСтрока(ТекстИнформация_ПаузаИгра), ?(Объект.ДемонстрацияОтвета,"Демонстрация:",Объект.ВопросЗаголовок), ТекстИнформация_ПаузаИгра)+" "+Информация_Время;	
	
	ПодключитьОбработчикОжидания("ОбновитьЭлементы_ОперативныйСчетчикВремени", 0.3, Истина);   // 0.3 - идеально:)
	
КонецПроцедуры	

&НаКлиенте
Процедура ОбновитьДанные_ХодИгры()
	
	// ОПТИМИЗАЦИЯ
	//
	// Получение данных во выполнению текущего маршрута выполнения вопроса и ответов пользователей
	// &НаСервереБезКонтекста !!!
	СтрВопрос = ПолучитьДанныеТекущегоВопросаИОтветовИгроков(Объект.Игра, Объект.Вопрос, Объект.НеСчитыватьОтветыИгроков, Объект.Команда, Объект.ВремяПоследнегоОбновления);
	//
	Новая_СинхронизацияСВременемСервера = СтрВопрос.ТекущаяДатаСеансаНаСервере - ТекущаяДата(); // Обновление синхронизации
	РассинхронизацияСекунд = Новая_СинхронизацияСВременемСервера - Объект.СинхронизацияСВременемСервера; 
	Объект.СинхронизацияСВременемСервера = Новая_СинхронизацияСВременемСервера;
	
	// Фиксация изменений:
	ИзменениеВопроса = (СтрВопрос.Вопрос<>Объект.Вопрос);
	Если НЕ ИзменениеВопроса Тогда		
		ИзмениласьДемонстрацииОтвета = (СтрВопрос.ДемонстрацияОтвета<>Объект.ДемонстрацияОтвета);
		Если НЕ ИзмениласьДемонстрацииОтвета Тогда
			ИзменениеВремени = ?(РассинхронизацияСекунд>0, РассинхронизацияСекунд,-РассинхронизацияСекунд)>2 
			ИЛИ (СтрВопрос.ВремяОкончанияПаузы<>Объект.ВремяОкончанияПаузы)
			ИЛИ (СтрВопрос.ВремяЗавершения<>Объект.ВремяЗавершения);
		КонецЕсли;			
	КонецЕсли;
	
	// Обновленных реквизитов маршрута
	ЗаполнитьЗначенияСвойств(Объект, СтрВопрос);	
	
	
	// Обновление полученных данных 
	Если ИзменениеВопроса Тогда 	
		ОбновитьДанные_Вопрос(Истина, СтрВопрос.МассивДанныхИгроков); // &НаСервере !!!
	ИначеЕсли ИзмениласьДемонстрацииОтвета Тогда // но не изменился вопрос
		ОбновитьДанные_Вопрос(Ложь, СтрВопрос.МассивДанныхИгроков);   // &НаСервере !!!
	Иначе
		Если НЕ Объект.НеСчитыватьОтветыИгроков Тогда // обновление ответов только для выполняемых вопросов
			ОбновитьДанные_ОтветыИгроковНаКлиенте(СтрВопрос.МассивДанныхИгроков, Ложь); // &НаКлиенте
		КонецЕсли;			
		Если ИзменениеВремени Тогда		
			ОбновитьЭлементы_ВидимостьДоступностьПолейРедактированияНаКлиенте();        // &НаКлиенте
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Функция ОкончаниеЛайка(Число)
	
	// Очень смешная функция
	// ЛАЙК :)
	
	Окончание = "ов";
	Если Число<5 ИЛИ Число>20 Тогда		
		ПравыйСимвол = Прав(Строка(Число),1);	
		Если ПравыйСимвол="1" Тогда
			Окончание = "";
		ИначеЕсли СтрНайти("2,3,4",ПравыйСимвол)>0 Тогда
			Окончание = "а";
		КонецЕсли; 			
	КонецЕсли;	
	
	Возврат Окончание;
	
КонецФункции	




