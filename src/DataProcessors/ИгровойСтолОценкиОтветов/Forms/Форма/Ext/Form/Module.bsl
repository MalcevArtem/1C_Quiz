

// Процедуры и функции
&НаСервере
Процедура УстановитьОтборПоИгреВДинамическихСписках()
	
	// Устанавливаем фиксированнный отбор в ДинамическихСписках
	//
	
	// ОтветыКоманд
	ФиксированныйОтбор = ОтветыКоманд.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы;
	ФиксированныйОтбор.Очистить();	
	ЭлементОтбора = ФиксированныйОтбор.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Игра");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Объект.Игра;
	Если ТолькоТекстовыеВопросы Тогда
		ЭлементОтбора = ФиксированныйОтбор.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ВидВопроса");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = Перечисления.ВидВопроса.ВопросСОтветом;
	КонецЕсли;
	Если ТолькоНеОбработанныеОтветы Тогда
		ЭлементОтбора = ФиксированныйОтбор.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ответственный");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = Справочники.Пользователи.ПустаяСсылка();
	КонецЕсли;
	
	// ОтветыИгроков
	ФиксированныйОтбор = ОтветыИгроков.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы;
	ФиксированныйОтбор.Очистить();	
	ЭлементОтбора = ФиксированныйОтбор.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Игра");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Объект.Игра;
	
	// РейтингиИгроков
	ФиксированныйОтбор = РейтингиИгроков.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы;
	ФиксированныйОтбор.Очистить();	
	ЭлементОтбора = ФиксированныйОтбор.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Игра");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Объект.Игра;
	
КонецПроцедуры

&НаСервере
Процедура ОтветКомандыНаСервере(ОтветПравильный)
	
	Если ЗначениеЗаполнено(Объект.Игра) И ЗначениеЗаполнено(Объект.ОК_Вопрос) И ЗначениеЗаполнено(Объект.ОК_Команда) Тогда
		
		Запись = РегистрыСведений.ОтветыКоманд.СоздатьМенеджерЗаписи();
		Запись.Игра = Объект.Игра;
		Запись.Вопрос = Объект.ОК_Вопрос;
		Запись.Команда = Объект.ОК_Команда;
		Запись.НомерСтр = Объект.ОК_НомерСтр;
		Запись.Прочитать();
		Если Запись.Выбран() Тогда
			Запись.Баллы = ?(ОтветПравильный, Запись.БаллыНоминальные, 0);
			Запись.Ответственный = Объект.Ответственный;
			Запись.Записать(Истина);
		КонецЕсли;
		
		Элементы.ОтветыКоманд.Обновить();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РасчетСтатьи(СтатьяРейтинга, Рассчитывать, Коэффициент)
	
	Если Ложь Тогда СтатьяРейтинга = Справочники.СтатьиРейтинга.ПустаяСсылка(); КонецЕсли;
	
	// Очистка данных по статье:
	Набор = РегистрыСведений.РейтингиИгроков.СоздатьНаборЗаписей();
	Набор.Отбор.Игра.Установить(Объект.Игра);
	Набор.Отбор.СтатьяРейтинга.Установить(СтатьяРейтинга);
	Набор.Очистить();
	Набор.Записать(Истина);
	
	// Т.е. только очищаем регистр от данных этой статьи
	Если НЕ Рассчитывать Тогда Возврат; КонецЕсли;
	
	
	Если СтатьяРейтинга.Имя = "ЗаОтветыНаТест" Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОтветыИгроков.Игра КАК Игра,
		|	ОтветыИгроков.Вопрос КАК Вопрос,
		|	ОтветыИгроков.НомерСтр КАК НомерСтр,
		|	ОтветыИгроков.Игрок КАК Игрок,
		|	ОтветыИгроков.Ответ КАК Ответ,
		|	ОтветыИгроков.Вопрос.Баллы КАК БаллыОценка
		|ПОМЕСТИТЬ Д_ОтветыИгроковНаТесты
		|ИЗ
		|	РегистрСведений.ОтветыИгроков КАК ОтветыИгроков
		|ГДЕ
		|	ОтветыИгроков.Игра = &Игра
		|	И ОтветыИгроков.НомерСтр = 1
		|	И ОтветыИгроков.Вопрос.ВидВопроса = ЗНАЧЕНИЕ(Перечисление.ВидВопроса.Тест)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Д_ОтветыИгроковНаТесты.Вопрос КАК Вопрос
		|ПОМЕСТИТЬ О_Вопросы
		|ИЗ
		|	Д_ОтветыИгроковНаТесты КАК Д_ОтветыИгроковНаТесты
		|
		|СГРУППИРОВАТЬ ПО
		|	Д_ОтветыИгроковНаТесты.Вопрос
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВопросыОтветыНаВопрос.Ссылка КАК Вопрос,
		|	ВЫБОР
		|		КОГДА ВопросыОтветыНаВопрос.Ссылка.ИспользоватьПредставление
		|			ТОГДА ВопросыОтветыНаВопрос.Представление
		|		ИНАЧЕ ВопросыОтветыНаВопрос.НомерСтроки
		|	КОНЕЦ КАК ОтветПравильный
		|ПОМЕСТИТЬ Д_ПравильныеОтветы
		|ИЗ
		|	О_Вопросы КАК О_Вопросы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Вопросы.ОтветыНаВопрос КАК ВопросыОтветыНаВопрос
		|		ПО О_Вопросы.Вопрос = ВопросыОтветыНаВопрос.Ссылка
		|			И (ВопросыОтветыНаВопрос.ОтветНаТест)
		|ГДЕ
		|	ВопросыОтветыНаВопрос.ОтветНаТест
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Д_ОтветыИгроковНаТесты.Игра КАК Игра,
		|	Д_ОтветыИгроковНаТесты.Вопрос КАК Вопрос,
		|	Д_ОтветыИгроковНаТесты.НомерСтр КАК НомерСтр,
		|	Д_ОтветыИгроковНаТесты.Игрок КАК Игрок,
		|	Д_ОтветыИгроковНаТесты.БаллыОценка КАК Баллы,
		|	Д_ОтветыИгроковНаТесты.Ответ КАК Ответ,
		|	Д_ПравильныеОтветы.ОтветПравильный КАК ОтветПравильный
		|ИЗ
		|	Д_ОтветыИгроковНаТесты КАК Д_ОтветыИгроковНаТесты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Д_ПравильныеОтветы КАК Д_ПравильныеОтветы
		|		ПО Д_ОтветыИгроковНаТесты.Вопрос = Д_ПравильныеОтветы.Вопрос";
		Запрос.УстановитьПараметр("Игра", Объект.Игра);
		
		РезультатЗапроса = Запрос.Выполнить();	
		Выборка = РезультатЗапроса.Выбрать();		
		Пока Выборка.Следующий() Цикл
			
			Если Строка(Выборка.Ответ)=Строка(Выборка.ОтветПравильный) Тогда			
				Запись = РегистрыСведений.РейтингиИгроков.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(Запись, Выборка);
				Запись.Баллы = Выборка.Баллы * Коэффициент;
				Запись.СтатьяРейтинга = СтатьяРейтинга;
				Запись.ДатаОбработки = Объект.ДатаОбработки;
				Запись.ОсновныеБаллы = Истина;
				Запись.Записать();			
			КонецЕсли;	
			
		КонецЦикла;
		
	КонецЕсли;	
	
	
	
	Если СтатьяРейтинга.Имя = "ЗаОтветыНаТекстовыеВопросы" Тогда
		
		//1. Расстояние Левенштейна
		//Возвращает число, которое показывает сколько нужно сделать операций (вставка, удаление или замена) для того, 
		//чтобы превратить одну строку в другую.
		//Свойства: простая реализация; зависимость от порядка слов; на выходе число; которое надо с чем-то сравнить.
		//	
		//2. Алгоритм шинглов
		//Разбивает тексты на шинглы (англ. — чешуйки), т.е цепочки по 10 слов (с пересечениями), 
		//применив к шинглам хеш-функции получает матрицы, которые и сравнивает между собой.
		//Свойства: чтобы реализовать алгоритм надо подробно изучать мат.часть; работает на больших текстах; 
		//нет зависимости от порядка предложений.
		//	
		//3. Коэффициент Жаккара (частное — коэф. Танимото)
		// К = с/(a+b-c)
		//Вычисляет коэффициент по формуле:
		//здесь a — количество символов в первой строке, b — количество символов во второй строке, c — количество совпадающих символов.
		//Свойства: прост в реализации; низкая точность, так как «abc» и «bca» для него одно и то же.
		//
		// Необходимо предусмотреть транслит с Анг. на Рус.
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОтветыИгроков.Игра КАК Игра,
		|	ОтветыИгроков.Вопрос КАК Вопрос,
		|	ОтветыИгроков.НомерСтр КАК НомерСтр,
		|	ОтветыИгроков.Игрок КАК Игрок,
		|	ОтветыИгроков.Ответ КАК Ответ,
		|	ОтветыИгроков.Вопрос.Баллы КАК БаллыОценка
		|ПОМЕСТИТЬ Д_ОтветыИгроковНаТесты
		|ИЗ
		|	РегистрСведений.ОтветыИгроков КАК ОтветыИгроков
		|ГДЕ
		|	ОтветыИгроков.Игра = &Игра
		|	И ОтветыИгроков.Вопрос.ВидВопроса = ЗНАЧЕНИЕ(Перечисление.ВидВопроса.ВопросСОтветом)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Д_ОтветыИгроковНаТесты.Вопрос КАК Вопрос
		|ПОМЕСТИТЬ О_Вопросы
		|ИЗ
		|	Д_ОтветыИгроковНаТесты КАК Д_ОтветыИгроковНаТесты
		|
		|СГРУППИРОВАТЬ ПО
		|	Д_ОтветыИгроковНаТесты.Вопрос
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВопросыОтветыНаВопрос.Ссылка КАК Вопрос,
		|	ВопросыОтветыНаВопрос.НомерСтроки КАК НомерСтр,
		|	ВопросыОтветыНаВопрос.Ответ КАК ОтветПравильный
		|ПОМЕСТИТЬ Д_ПравильныеОтветы
		|ИЗ
		|	О_Вопросы КАК О_Вопросы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Вопросы.ОтветыНаВопрос КАК ВопросыОтветыНаВопрос
		|		ПО О_Вопросы.Вопрос = ВопросыОтветыНаВопрос.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Д_ОтветыИгроковНаТесты.Игра КАК Игра,
		|	Д_ОтветыИгроковНаТесты.Вопрос КАК Вопрос,
		|	Д_ОтветыИгроковНаТесты.НомерСтр КАК НомерСтр,
		|	Д_ОтветыИгроковНаТесты.Игрок КАК Игрок,
		|	Д_ОтветыИгроковНаТесты.БаллыОценка КАК Баллы,
		|	Д_ОтветыИгроковНаТесты.Ответ КАК Ответ,
		|	Д_ПравильныеОтветы.ОтветПравильный КАК ОтветПравильный
		|ИЗ
		|	Д_ОтветыИгроковНаТесты КАК Д_ОтветыИгроковНаТесты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Д_ПравильныеОтветы КАК Д_ПравильныеОтветы
		|		ПО Д_ОтветыИгроковНаТесты.Вопрос = Д_ПравильныеОтветы.Вопрос
		|			И Д_ОтветыИгроковНаТесты.НомерСтр = Д_ПравильныеОтветы.НомерСтр";
		Запрос.УстановитьПараметр("Игра", Объект.Игра);
		
		РезультатЗапроса = Запрос.Выполнить();	
		Выборка = РезультатЗапроса.Выбрать();		
		Пока Выборка.Следующий() Цикл
			
			СтрОтветИгрока = НРЕГ(СокрЛП(Выборка.Ответ));
			СтрОтветВерный = НРЕГ(СокрЛП(Выборка.ОтветПравильный));
			
			КоэффициентСовпадения = 0;
			
			// Опредлеление коэффициента совпадения строки [комбинированный способ]
			Если СтрОтветИгрока=СтрОтветВерный Тогда
				
				// Полное совпадение 100%
				КоэффициентСовпадения = 1;
				
			ИначеЕсли СтрНайти(СтрОтветВерный, СтрОтветИгрока)>0 Тогда
				
				// Полное совпадение 95%  "условный" Нет точного совпадение но ответ точно верный или нет ошибки в слове ответа
				КоэффициентСовпадения = 0.95;
				
			Иначе	
				
				// Коэффициент Жаккара (частное — коэф. Танимото)
				КолСовпадающихСимв = 0;
				Для _н=1 По СтрДлина(СтрОтветИгрока) Цикл				
					ПозицияСимволаВСтроке = СтрНайти(СтрОтветВерный, Сред(СтрОтветИгрока,_н,1));				
					Если ПозицияСимволаВСтроке>0 Тогда 
						КолСовпадающихСимв = КолСовпадающихСимв + 1;				
					КонецЕсли;						
				КонецЦикла;
				// К = с/(a+b-c);		
				КоэффициентСовпадения = КолСовпадающихСимв / (СтрДлина(СтрОтветИгрока) + СтрДлина(СтрОтветВерный) - КолСовпадающихСимв);
				
				
				//// Коэффициент Мальцева "ТРИ символьное совпадение"
				//// Процент совпадения "тройного" символа
				////			
				//ДлинаСтрИгрока = СтрДлина(СтрОтветИгрока);
				//Если ДлинаСтрИгрока >=3 Тогда
				//	ЧислоПоследовательныхСимволов = 0;
				//	Для _н=1 По ДлинаСтрИгрока-2 Цикл							
				//		Если СтрНайти(СтрОтветВерный, Сред(СтрОтветИгрока,_н,3))>0 Тогда
				//			ЧислоПоследовательныхСимволов = ЧислоПоследовательныхСимволов + 1;
				//		КонецЕсли;				
				//	КонецЦикла;				
				//	КоэффициентСовпадения2 = ЧислоПоследовательныхСимволов / (ДлинаСтрИгрока-2);				
				//Иначе			
				//	КоэффициентСовпадения2 = 1;					
				//КонецЕсли;
				
			КонецЕсли;			
			
			Если КоэффициентСовпадения>0 Тогда			
				Запись = РегистрыСведений.РейтингиИгроков.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(Запись, Выборка);
				Запись.Баллы = Выборка.Баллы * Коэффициент * КоэффициентСовпадения;
				Запись.СтатьяРейтинга = СтатьяРейтинга;
				Запись.ДатаОбработки = Объект.ДатаОбработки;
				Запись.ОсновныеБаллы = Истина;
				Запись.Записать();			
			КонецЕсли;	
			
		КонецЦикла;
		
	КонецЕсли;	         
	
	
	Если СтатьяРейтинга.Имя = "НадбавкаЗаЛидирующуюКоманду" Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОтветыКоманд.Игра КАК Игра,
		|	ОтветыКоманд.Команда КАК Команда,
		|	СУММА(ОтветыКоманд.Баллы) КАК БаллыИтого
		|ПОМЕСТИТЬ Д_ИтогИгры
		|ИЗ
		|	РегистрСведений.ОтветыКоманд КАК ОтветыКоманд
		|ГДЕ
		|	ОтветыКоманд.Игра = &Игра
		|
		|СГРУППИРОВАТЬ ПО
		|	ОтветыКоманд.Игра,
		|	ОтветыКоманд.Команда
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Д_ИтогИгры.Игра КАК Игра,
		|	МАКСИМУМ(Д_ИтогИгры.БаллыИтого) КАК БаллыИтого
		|ПОМЕСТИТЬ Д_МаксимумБаллов
		|ИЗ
		|	Д_ИтогИгры КАК Д_ИтогИгры
		|
		|СГРУППИРОВАТЬ ПО
		|	Д_ИтогИгры.Игра
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Д_ИтогИгры.Игра КАК Игра,
		|	Д_ИтогИгры.Команда КАК Команда,
		|	Д_ИтогИгры.БаллыИтого КАК БаллыИтого
		|ПОМЕСТИТЬ Д_ЛидирующиеКоманды
		|ИЗ
		|	Д_ИтогИгры КАК Д_ИтогИгры
