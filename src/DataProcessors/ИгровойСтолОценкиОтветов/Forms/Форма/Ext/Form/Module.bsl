&НаКлиенте
Процедура ОтветыКомандПриАктивизацииСтроки(Элемент)
	
	// Реквизиты активизированной строки
	Если Элемент.ТекущиеДанные<>Неопределено Тогда
		Объект.ОК_Вопрос   = Элемент.ТекущиеДанные.Вопрос;
		Объект.ОК_Команда  = Элемент.ТекущиеДанные.Команда;
		Объект.ОК_НомерСтр = Элемент.ТекущиеДанные.НомерСтр;
	Иначе
		Объект.ОК_Вопрос   = ПредопределенноеЗначение("Справочник.Вопросы.ПустаяСсылка");
		Объект.ОК_Команда  = ПредопределенноеЗначение("Справочник.Команды.ПустаяСсылка");
		Объект.ОК_НомерСтр = 0;
	КонецЕсли;
	
КонецПроцедуры

