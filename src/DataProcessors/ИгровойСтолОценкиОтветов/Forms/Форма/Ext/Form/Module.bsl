		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветыКоманд КАК ОтветыКоманд
		|		ПО (Команда_БаллыИгрокаЗаБольшиеВопросы.Команда = ОтветыКоманд.Команда)
		|			И (Команда_БаллыИгрокаЗаБольшиеВопросы.Игра = ОтветыКоманд.Игра)
		|			И (Команда_БаллыИгрокаЗаБольшиеВопросы.Вопрос = ОтветыКоманд.Вопрос)
		|			И (Команда_БаллыИгрокаЗаБольшиеВопросы.НомерСтр = ОтветыКоманд.НомерСтр)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветыИгроков КАК ОтветыИгроков
		|		ПО (Команда_БаллыИгрокаЗаБольшиеВопросы.Команда = ОтветыИгроков.Команда)
		|			И (Команда_БаллыИгрокаЗаБольшиеВопросы.Игра = ОтветыИгроков.Игра)
		|			И (Команда_БаллыИгрокаЗаБольшиеВопросы.Игрок = ОтветыИгроков.Игрок)
		|			И (Команда_БаллыИгрокаЗаБольшиеВопросы.Вопрос = ОтветыИгроков.Вопрос)
		|			И (Команда_БаллыИгрокаЗаБольшиеВопросы.НомерСтр = ОтветыИгроков.НомерСтр)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Д_ВремяОтветовИгроков.Команда КАК Команда,
		|	Д_ВремяОтветовИгроков.НомерИгрока КАК НомерИгрока,
		|	Д_ВремяОтветовИгроков.Игра КАК Игра,
		|	Д_ВремяОтветовИгроков.Игрок КАК Игрок,
		|	Д_ВремяОтветовИгроков.Вопрос КАК Вопрос,
		|	Д_ВремяОтветовИгроков.НомерСтр КАК НомерСтр,
		|	Д_ВремяОтветовИгроков.Баллы КАК Баллы,
		|	Д_ВремяОтветовИгроков.ВремяОтветаКоманды КАК ВремяОтветаКоманды,
		|	Д_ВремяОтветовИгроков.ВремяОтветаИгрока КАК ВремяОтветаИгрока
		|ИЗ
		|	Д_ВремяОтветовИгроков КАК Д_ВремяОтветовИгроков
		|ГДЕ
		|	Д_ВремяОтветовИгроков.ВремяОтветаИгрока <= Д_ВремяОтветовИгроков.ВремяОтветаКоманды";			
		Запрос.УстановитьПараметр("Игра", Объект.Игра);
		
		Результат = Запрос.Выполнить();		
		Выборка = Результат.Выбрать();	
		Пока Выборка.Следующий() Цикл		
			Запись = РегистрыСведений.РейтингиИгроков.СоздатьМенеджерЗаписи();
			Запись.Игра = Объект.Игра;
			Запись.СтатьяРейтинга = СтатьяРейтинга;
			Запись.Игрок = Выборка.Игрок;
			Запись.Вопрос = Выборка.Вопрос;
			Запись.НомерСтр = Выборка.НомерСтр;
			Запись.Баллы = Выборка.Баллы * Коэффициент;
			Запись.ДатаОбработки = Объект.ДатаОбработки;
			Запись.Комментарий = Строка(Выборка.Команда) + "  ВИ:"+Строка(Выборка.ВремяОтветаИгрока) + "  ВК:"+Строка(Выборка.ВремяОтветаКоманды);
			Запись.Записать();				
		КонецЦикла;
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ВидимостьКолонокТЧОтветовКоманд()
	
	Элементы.ОтветыКомандВидВопроса.Видимость    = НЕ ТолькоТекстовыеВопросы;
	Элементы.ОтветыКомандОтветственный.Видимость = НЕ ТолькоНеОбработанныеОтветы;
	
КонецПроцедуры	







// Команды: ОтветыКоманд
&НаКлиенте
Процедура ОбновитьДинамическийСписокОтветовКоманд(Команда)
	
	Элементы.ОтветыКоманд.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДинамическийСписокРассмотренияАпелляций(Команда)
	
	Элементы.ПодачаАпелляции.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПравильныеОтветыКоманды(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Игра) Тогда
		ПоказатьПредупреждение(,"Не задана игра!");
		Возврат;
	КонецЕсли;
	ОбновитьПравильныеОтветыКомандыНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПравильныеОтветыКомандыНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОтветыКоманд.Игра КАК Игра,
	|	ОтветыКоманд.Вопрос КАК Вопрос,
	|	ОтветыКоманд.Команда КАК Команда,
	|	ОтветыКоманд.НомерСтр КАК НомерСтр
	|ПОМЕСТИТЬ Д_ОтветыКоманд
	|ИЗ
	|	РегистрСведений.ОтветыКоманд КАК ОтветыКоманд
	|ГДЕ
	|	ОтветыКоманд.Игра = &Игра
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Д_ОтветыКоманд.Вопрос КАК Вопрос
	|ПОМЕСТИТЬ Д_Вопросы
	|ИЗ
	|	Д_ОтветыКоманд КАК Д_ОтветыКоманд
	|
	|СГРУППИРОВАТЬ ПО
	|	Д_ОтветыКоманд.Вопрос
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОтветыНаВопрос_Тесты.Ссылка КАК Вопрос,
	|	1 КАК НомерСтр,
	|	ВЫБОР
	|		КОГДА ОтветыНаВопрос_Тесты.Ссылка.ИспользоватьПредставление
	|			ТОГДА ОтветыНаВопрос_Тесты.Представление
	|		ИНАЧЕ ОтветыНаВопрос_Тесты.НомерСтроки
	|	КОНЕЦ КАК ОтветПравильный,
	|	ОтветыНаВопрос_Тесты.Ссылка.Баллы КАК БаллыНоминальные
	|ПОМЕСТИТЬ Д_ПравильныеОтветыНаТесты
	|ИЗ
	|	Д_Вопросы КАК Д_Вопросы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Вопросы.ОтветыНаВопрос КАК ОтветыНаВопрос_Тесты
	|		ПО Д_Вопросы.Вопрос = ОтветыНаВопрос_Тесты.Ссылка
	|			И (ОтветыНаВопрос_Тесты.ОтветНаТест = ИСТИНА)
	|			И (Д_Вопросы.Вопрос.ВидВопроса = ЗНАЧЕНИЕ(Перечисление.ВидВопроса.Тест))
	|ГДЕ
	|	ОтветыНаВопрос_Тесты.ОтветНаТест = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОтветыНаВопрос_Тесты.Ссылка КАК Вопрос,
	|	ОтветыНаВопрос_Тесты.НомерСтроки КАК НомерСтр,
	|	ОтветыНаВопрос_Тесты.Ответ КАК ОтветПравильный,
	|	ОтветыНаВопрос_Тесты.Ссылка.Баллы КАК БаллыНоминальные
	|ПОМЕСТИТЬ Д_ПравильныеТекстовыеОтветыНаВопросы
	|ИЗ
	|	Д_Вопросы КАК Д_Вопросы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Вопросы.ОтветыНаВопрос КАК ОтветыНаВопрос_Тесты
	|		ПО Д_Вопросы.Вопрос = ОтветыНаВопрос_Тесты.Ссылка
	|			И (Д_Вопросы.Вопрос.ВидВопроса = ЗНАЧЕНИЕ(Перечисление.ВидВопроса.ВопросСОтветом))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Д_ОтветыКоманд.Игра КАК Игра,
	|	Д_ОтветыКоманд.Вопрос КАК Вопрос,
	|	Д_ОтветыКоманд.Команда КАК Команда,
	|	Д_ОтветыКоманд.НомерСтр КАК НомерСтр,
	|	ЕСТЬNULL(Д_ПравильныеОтветыНаТесты.ОтветПравильный, Д_ПравильныеТекстовыеОтветыНаВопросы.ОтветПравильный) КАК ОтветПравильный,
	|	ЕСТЬNULL(Д_ПравильныеОтветыНаТесты.БаллыНоминальные, Д_ПравильныеТекстовыеОтветыНаВопросы.БаллыНоминальные) КАК БаллыНоминальные
	|ИЗ
	|	Д_ОтветыКоманд КАК Д_ОтветыКоманд
	|		ЛЕВОЕ СОЕДИНЕНИЕ Д_ПравильныеОтветыНаТесты КАК Д_ПравильныеОтветыНаТесты
	|		ПО Д_ОтветыКоманд.Вопрос = Д_ПравильныеОтветыНаТесты.Вопрос
	|			И Д_ОтветыКоманд.НомерСтр = Д_ПравильныеОтветыНаТесты.НомерСтр
	|		ЛЕВОЕ СОЕДИНЕНИЕ Д_ПравильныеТекстовыеОтветыНаВопросы КАК Д_ПравильныеТекстовыеОтветыНаВопросы
	|		ПО Д_ОтветыКоманд.Вопрос = Д_ПравильныеТекстовыеОтветыНаВопросы.Вопрос
	|			И Д_ОтветыКоманд.НомерСтр = Д_ПравильныеТекстовыеОтветыНаВопросы.НомерСтр";	
	Запрос.УстановитьПараметр("Игра", Объект.Игра);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();	
	Пока Выборка.Следующий() Цикл	
		Запись = РегистрыСведений.ОтветыКоманд.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, Выборка, "Игра,Вопрос,Команда,НомерСтр");
		Запись.Прочитать();
		Если Запись.Выбран() Тогда
			ЗаполнитьЗначенияСвойств(Запись, Выборка, "ОтветПравильный,БаллыНоминальные");
			Запись.Записать(Истина);
		КонецЕсли;
	КонецЦикла;	
	
	Элементы.ОтветыКоманд.Обновить();
	
	Сообщить("Успешно обновлено "+Выборка.Количество()+" ответов / начисляемых баллов команд!");
	
КонецПроцедуры

&НаКлиенте
Процедура ОценкаТестовКоманды(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Игра) Тогда
		ПоказатьПредупреждение(,"Не задана игра!");
		Возврат;
	КонецЕсли;
	ОценкаТестовКомандыНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ОценкаТестовКомандыНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОтветыКоманд.Игра КАК Игра,
	|	ОтветыКоманд.Вопрос КАК Вопрос,
	|	ОтветыКоманд.Команда КАК Команда,
	|	ОтветыКоманд.НомерСтр КАК НомерСтр,
	|	ВЫБОР
	|		КОГДА ОтветыКоманд.Ответ = ОтветыКоманд.ОтветПравильный
	|			ТОГДА ОтветыКоманд.БаллыНоминальные
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Баллы
	|ИЗ
	|	РегистрСведений.ОтветыКоманд КАК ОтветыКоманд
	|ГДЕ
	|	ОтветыКоманд.Игра = &Игра
	|	И ОтветыКоманд.Вопрос.ВидВопроса = ЗНАЧЕНИЕ(Перечисление.ВидВопроса.Тест)";	
	Запрос.УстановитьПараметр("Игра", Объект.Игра);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();	
	Пока Выборка.Следующий() Цикл	
		Запись = РегистрыСведений.ОтветыКоманд.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, Выборка, "Игра,Вопрос,Команда,НомерСтр");
		Запись.Прочитать();
		Если Запись.Выбран() Тогда
			Запись.Баллы = Выборка.Баллы;
			Запись.Ответственный = Объект.Ответственный;
			Запись.Записать(Истина);
		КонецЕсли;
	КонецЦикла;	
	
	Элементы.ОтветыКоманд.Обновить();
	
	Сообщить("Успешно оценено "+Выборка.Количество()+" ответов на тесты!");
	
КонецПроцедуры

