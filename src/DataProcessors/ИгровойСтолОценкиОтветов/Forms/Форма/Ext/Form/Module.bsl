&НаСервере
Процедура ЗаполнитьВсеСтатьиРейтингаИгроковНаСервере()
	
	// Очистка
	Объект.ТЧСтатьиРейтинга.Очистить();
	
	
	// Заполнение
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИСТИНА КАК Рассчитывать,
	|	СтатьиРейтинга.Код КАК Код,
	|	СтатьиРейтинга.Ссылка КАК СтатьяРейтинга,
	|	СтатьиРейтинга.Коэффициент КАК Коэффициент
	|ИЗ
	|	Справочник.СтатьиРейтинга КАК СтатьиРейтинга
	|ГДЕ
	|	НЕ СтатьиРейтинга.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	СтатьиРейтинга.Код";	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Объект.ТЧСтатьиРейтинга.Добавить(), Выборка);
	КонецЦикла;	
	
КонецПроцедуры

