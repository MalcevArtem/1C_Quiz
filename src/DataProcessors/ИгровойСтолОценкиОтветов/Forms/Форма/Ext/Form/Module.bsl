&НаСервере
Процедура РассчитатьРейтингИгроковНаСервере()
	
	Если Объект.Игра.Пустая() Тогда
		ИгровойКлиентСервер.СообщитьПользователю("Не заполнена игра!", , "Объект.Игра");
		Возврат;
	КонецЕсли;	 
	
	Объект.ДатаОбработки = ТекущаяДатаСеанса();
	
	// Последовательный расчёт
	Для Каждого ЭлТЧ Из Объект.ТЧСтатьиРейтинга Цикл
		Если ЗначениеЗаполнено(ЭлТЧ.СтатьяРейтинга) Тогда			
			РасчетСтатьи(ЭлТЧ.СтатьяРейтинга, ЭлТЧ.Рассчитывать, ЭлТЧ.Коэффициент);		
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

