		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	БаллыЗаОтветыНаВопросы.Вопрос КАК Вопрос,
		|	БаллыЗаОтветыНаВопросы.НомерСтр КАК НомерСтр,
		|	МАКСИМУМ(БаллыЗаОтветыНаВопросы.Баллы) КАК МаксимальныеБаллы
		|ПОМЕСТИТЬ ОпределениеМаксимальногоКоличестваБаллов
		|ИЗ
		|	БаллыЗаОтветыНаВопросы КАК БаллыЗаОтветыНаВопросы
		|
		|СГРУППИРОВАТЬ ПО
		|	БаллыЗаОтветыНаВопросы.Вопрос,
		|	БаллыЗаОтветыНаВопросы.НомерСтр
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	БаллыЗаОтветыНаВопросы.Игра КАК Игра,
		|	БаллыЗаОтветыНаВопросы.Игрок КАК Игрок,
		|	БаллыЗаОтветыНаВопросы.Вопрос КАК Вопрос,
		|	БаллыЗаОтветыНаВопросы.НомерСтр КАК НомерСтр,
		|	БаллыЗаОтветыНаВопросы.Баллы КАК Баллы
		|ПОМЕСТИТЬ О_МаксимальныеОтветы
		|ИЗ
		|	БаллыЗаОтветыНаВопросы КАК БаллыЗаОтветыНаВопросы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОпределениеМаксимальногоКоличестваБаллов КАК ОпределениеМаксимальногоКоличестваБаллов
		|		ПО БаллыЗаОтветыНаВопросы.Вопрос = ОпределениеМаксимальногоКоличестваБаллов.Вопрос
		|			И БаллыЗаОтветыНаВопросы.НомерСтр = ОпределениеМаксимальногоКоличестваБаллов.НомерСтр
		|			И БаллыЗаОтветыНаВопросы.Баллы = ОпределениеМаксимальногоКоличестваБаллов.МаксимальныеБаллы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	О_МаксимальныеОтветы.Игра КАК Игра,
		|	О_МаксимальныеОтветы.Игрок КАК Игрок,
		|	О_МаксимальныеОтветы.Вопрос КАК Вопрос,
		|	О_МаксимальныеОтветы.НомерСтр КАК НомерСтр,
		|	О_МаксимальныеОтветы.Баллы КАК Баллы,
		|	ОтветыИгроков.ВремяОтвета КАК ВремяОтвета
		|ПОМЕСТИТЬ ВремяОтветовИгроков
		|ИЗ
		|	РегистрСведений.ОтветыИгроков КАК ОтветыИгроков
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ О_МаксимальныеОтветы КАК О_МаксимальныеОтветы
		|		ПО ОтветыИгроков.Игра = О_МаксимальныеОтветы.Игра
		|			И ОтветыИгроков.Вопрос = О_МаксимальныеОтветы.Вопрос
		|			И ОтветыИгроков.НомерСтр = О_МаксимальныеОтветы.НомерСтр
		|			И ОтветыИгроков.Игрок = О_МаксимальныеОтветы.Игрок
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВремяОтветовИгроков.Вопрос КАК Вопрос,
		|	ВремяОтветовИгроков.НомерСтр КАК НомерСтр,
		|	МИНИМУМ(ВремяОтветовИгроков.ВремяОтвета) КАК МинимальноеВремяОтвета
		|ПОМЕСТИТЬ ПервоеВремяОтвета
		|ИЗ
		|	ВремяОтветовИгроков КАК ВремяОтветовИгроков
		|
		|СГРУППИРОВАТЬ ПО
		|	ВремяОтветовИгроков.Вопрос,
		|	ВремяОтветовИгроков.НомерСтр
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВремяОтветовИгроков.Игра КАК Игра,
		|	ВремяОтветовИгроков.Игрок КАК Игрок,
		|	ВремяОтветовИгроков.Вопрос КАК Вопрос,
		|	ВремяОтветовИгроков.НомерСтр КАК НомерСтр,
		|	ВремяОтветовИгроков.ВремяОтвета КАК ВремяОтвета,
		|	ВремяОтветовИгроков.Баллы КАК Баллы
		|ИЗ
		|	ВремяОтветовИгроков КАК ВремяОтветовИгроков
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПервоеВремяОтвета КАК ПервоеВремяОтвета
		|		ПО ВремяОтветовИгроков.Вопрос = ПервоеВремяОтвета.Вопрос
		|			И ВремяОтветовИгроков.НомерСтр = ПервоеВремяОтвета.НомерСтр
		|			И ВремяОтветовИгроков.ВремяОтвета = ПервоеВремяОтвета.МинимальноеВремяОтвета";		
		Запрос.УстановитьПараметр("Игра", Объект.Игра);
		
		Результат = Запрос.Выполнить();		
		Выборка = Результат.Выбрать();		
		Пока Выборка.Следующий() Цикл
			
			Запись = РегистрыСведений.РейтингиИгроков.СоздатьМенеджерЗаписи();
			Запись.Игра = Выборка.Игра;
			Запись.СтатьяРейтинга = СтатьяРейтинга;
			Запись.Игрок = Выборка.Игрок;
			Запись.Вопрос = Выборка.Вопрос;
			Запись.НомерСтр = Выборка.НомерСтр;
			Запись.Баллы =  Выборка.Баллы * Коэффициент;
			Запись.ДатаОбработки = Объект.ДатаОбработки;
			Запись.Комментарий = "Время ответа: "+Строка(Выборка.ВремяОтвета);
			Запись.Записать();		
			
		КонецЦикла;
		
	КонецЕсли;	
	
	
	Если СтатьяРейтинга.Имя = "НадбавкаИгрокамЗаТекстовыеОтветы_БольшиеВопросы" Тогда  // [Уравниватель]
		
		// Только игрокам, чьи правильные ответы были даны раньше капитанов
		// Только по вопросам количество которых больше > 1      Пример: "Фильмы по смайликам"
		// 
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИграСписокКоманд.Команда КАК Команда
		|ПОМЕСТИТЬ Команды
		|ИЗ
		|	Документ.Игра.СписокКоманд КАК ИграСписокКоманд
		|ГДЕ
		|	ИграСписокКоманд.Ссылка = &Игра
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КомандыИгроки.Ссылка КАК Команда,
		|	КомандыИгроки.НомерСтроки КАК НомерИгрока,
		|	КомандыИгроки.Игрок КАК Игрок
		|ПОМЕСТИТЬ ИгрокиКоманды
		|ИЗ
		|	Команды КАК Команды
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Команды.Игроки КАК КомандыИгроки
		|		ПО Команды.Команда = КомандыИгроки.Ссылка
		|ГДЕ
		|	КомандыИгроки.НомерСтроки > 1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РейтингиИгроков.Игра КАК Игра,
		|	РейтингиИгроков.Игрок КАК Игрок,
		|	РейтингиИгроков.Вопрос КАК Вопрос,
		|	РейтингиИгроков.НомерСтр КАК НомерСтр,
		|	РейтингиИгроков.Баллы КАК Баллы
		|ПОМЕСТИТЬ БаллыЗаОтветыНаВопросы
		|ИЗ
		|	РегистрСведений.РейтингиИгроков КАК РейтингиИгроков
		|ГДЕ
		|	РейтингиИгроков.Игра = &Игра
		|	И РейтингиИгроков.ОсновныеБаллы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	БаллыЗаОтветыНаВопросы.Вопрос КАК Вопрос,
		|	МАКСИМУМ(БаллыЗаОтветыНаВопросы.НомерСтр) КАК КоличествоОтветов
		|ПОМЕСТИТЬ ОпределениеКоличестваОтветов
		|ИЗ
		|	БаллыЗаОтветыНаВопросы КАК БаллыЗаОтветыНаВопросы
		|
		|СГРУППИРОВАТЬ ПО
		|	БаллыЗаОтветыНаВопросы.Вопрос
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИгрокиКоманды.Команда КАК Команда,
		|	ИгрокиКоманды.НомерИгрока КАК НомерИгрока,
		|	БаллыЗаОтветыНаВопросы.Игра КАК Игра,
		|	БаллыЗаОтветыНаВопросы.Игрок КАК Игрок,
		|	БаллыЗаОтветыНаВопросы.Вопрос КАК Вопрос,
		|	БаллыЗаОтветыНаВопросы.НомерСтр КАК НомерСтр,
		|	БаллыЗаОтветыНаВопросы.Баллы КАК Баллы
		|ПОМЕСТИТЬ Команда_БаллыИгрокаЗаБольшиеВопросы
		|ИЗ
		|	БаллыЗаОтветыНаВопросы КАК БаллыЗаОтветыНаВопросы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОпределениеКоличестваОтветов КАК ОпределениеКоличестваОтветов
		|		ПО БаллыЗаОтветыНаВопросы.Вопрос = ОпределениеКоличестваОтветов.Вопрос
		|			И (ОпределениеКоличестваОтветов.КоличествоОтветов > 1)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИгрокиКоманды КАК ИгрокиКоманды
		|		ПО БаллыЗаОтветыНаВопросы.Игрок = ИгрокиКоманды.Игрок
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Команда_БаллыИгрокаЗаБольшиеВопросы.Команда КАК Команда,
		|	Команда_БаллыИгрокаЗаБольшиеВопросы.НомерИгрока КАК НомерИгрока,
		|	Команда_БаллыИгрокаЗаБольшиеВопросы.Игра КАК Игра,
		|	Команда_БаллыИгрокаЗаБольшиеВопросы.Игрок КАК Игрок,
		|	Команда_БаллыИгрокаЗаБольшиеВопросы.Вопрос КАК Вопрос,
		|	Команда_БаллыИгрокаЗаБольшиеВопросы.НомерСтр КАК НомерСтр,
		|	Команда_БаллыИгрокаЗаБольшиеВопросы.Баллы КАК Баллы,
		|	ЕСТЬNULL(ОтветыКоманд.ВремяОтвета, ДАТАВРЕМЯ(3000, 5, 31)) КАК ВремяОтветаКоманды,
		|	ЕСТЬNULL(ОтветыИгроков.ВремяОтвета, ДАТАВРЕМЯ(3000, 5, 31)) КАК ВремяОтветаИгрока
		|ПОМЕСТИТЬ Д_ВремяОтветовИгроков
		|ИЗ
