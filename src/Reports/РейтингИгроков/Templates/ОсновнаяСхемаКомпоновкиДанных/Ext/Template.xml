<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Игрок</dataPath>
			<field>Игрок</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
			<presentationExpression>Строка(Игрок) + Капитан</presentationExpression>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:use>false</dcscor:use>
					<dcscor:parameter>МинимальнаяШирина</dcscor:parameter>
					<dcscor:value xsi:type="xs:decimal">40</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Рейтинг</dataPath>
			<field>Рейтинг</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Рейтинг</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Капитан</dataPath>
			<field>Капитан</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Капитан</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Команда</dataPath>
			<field>Команда</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Команда</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ИграСписокКоманд.Команда КАК Команда
ПОМЕСТИТЬ Д_Команды
ИЗ
	Документ.Игра.СписокКоманд КАК ИграСписокКоманд
ГДЕ
	ИграСписокКоманд.Ссылка = &amp;Игра
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	КомандыИгроки.Игрок КАК Игрок,
	КомандыИгроки.Ссылка КАК Команда,
	ВЫБОР
		КОГДА КомандыИгроки.НомерСтроки = 1
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ЭтоКапитан
ПОМЕСТИТЬ Д_ИгрокКомандаКапитан
ИЗ
	Д_Команды КАК Д_Команды
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Команды.Игроки КАК КомандыИгроки
		ПО Д_Команды.Команда = КомандыИгроки.Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	РейтингиИгроков.Игрок КАК Игрок,
	СУММА(РейтингиИгроков.Баллы * 100) КАК Рейтинг
ПОМЕСТИТЬ Г_ИгрокРейтинг
ИЗ
	РегистрСведений.РейтингиИгроков КАК РейтингиИгроков
ГДЕ
	(РейтингиИгроков.Игра = &amp;Игра
			ИЛИ &amp;Игра = ЗНАЧЕНИЕ(Документ.Игра.ПустаяСсылка))

СГРУППИРОВАТЬ ПО
	РейтингиИгроков.Игрок
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Г_ИгрокРейтинг.Игрок КАК Игрок,
	Г_ИгрокРейтинг.Рейтинг КАК Рейтинг,
	Д_ИгрокКомандаКапитан.Команда КАК Команда,
	ВЫБОР
		КОГДА Д_ИгрокКомандаКапитан.ЭтоКапитан
			ТОГДА " [Капитан]"
		ИНАЧЕ ""
	КОНЕЦ КАК Капитан
ИЗ
	Г_ИгрокРейтинг КАК Г_ИгрокРейтинг
		ЛЕВОЕ СОЕДИНЕНИЕ Д_ИгрокКомандаКапитан КАК Д_ИгрокКомандаКапитан
		ПО Г_ИгрокРейтинг.Игрок = Д_ИгрокКомандаКапитан.Игрок</query>
	</dataSet>
	<totalField>
		<dataPath>Рейтинг</dataPath>
		<expression>Сумма(Рейтинг)</expression>
	</totalField>
	<parameter>
		<name>Игра</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Игра</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type xmlns:d4p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d4p1:DocumentRef.Игра</v8:Type>
		</valueType>
		<value xsi:nil="true"/>
		<useRestriction>true</useRestriction>
		<use>Always</use>
	</parameter>
	<parameter>
		<name>ТекущийПользователь</name>
		<title xsi:type="v8:LocalStringType">
