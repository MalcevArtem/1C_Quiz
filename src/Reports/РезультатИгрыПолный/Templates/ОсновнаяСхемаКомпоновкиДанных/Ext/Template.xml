		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ИграСписокВопросов.Ссылка КАК Игра,
	ИграСписокВопросов.НомерСтроки КАК НомерВопроса,
	ИграСписокВопросов.Вопрос КАК Вопрос,
	ИграСписокВопросов.Этап КАК Этап
ПОМЕСТИТЬ СтруктураИгры
ИЗ
	Документ.Игра.СписокВопросов КАК ИграСписокВопросов
ГДЕ
	ИграСписокВопросов.Ссылка = &amp;Игра
	И НЕ ИграСписокВопросов.ДемонстрацияОтвета
	И (ИграСписокВопросов.Вопрос.ВидВопроса = ЗНАЧЕНИЕ(Перечисление.ВидВопроса.Тест)
			ИЛИ ИграСписокВопросов.Вопрос.ВидВопроса = ЗНАЧЕНИЕ(Перечисление.ВидВопроса.ВопросСОтветом))
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	СтруктураИгры.Вопрос КАК Вопрос,
	СтруктураИгры.Игра КАК Игра
ПОМЕСТИТЬ ОТБОР_Вопросы
ИЗ
	СтруктураИгры КАК СтруктураИгры

СГРУППИРОВАТЬ ПО
	СтруктураИгры.Вопрос,
	СтруктураИгры.Игра
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЭмоциональныеОценкиВопросов.Вопрос КАК Вопрос,
	СУММА(ЭмоциональныеОценкиВопросов.Оценка) КАК ОбщаяЭмоциональнаяОценка,
	СУММА(ВЫБОР
			КОГДА ЭмоциональныеОценкиВопросов.Оценка &gt; 0
				ТОГДА ЭмоциональныеОценкиВопросов.Оценка
			ИНАЧЕ 0
		КОНЕЦ) КАК КоличествоЛайков,
	СУММА(ВЫБОР
			КОГДА ЭмоциональныеОценкиВопросов.Оценка &lt; 0
				ТОГДА -ЭмоциональныеОценкиВопросов.Оценка
			ИНАЧЕ 0
		КОНЕЦ) КАК КоличествоДизлайков
ПОМЕСТИТЬ Г_ЭмоциональнаяОценкаВопросовИгры
ИЗ
	ОТБОР_Вопросы КАК ОТБОР_Вопросы
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭмоциональныеОценкиВопросов КАК ЭмоциональныеОценкиВопросов
		ПО ОТБОР_Вопросы.Вопрос = ЭмоциональныеОценкиВопросов.Вопрос
			И ОТБОР_Вопросы.Игра = ЭмоциональныеОценкиВопросов.Игра

СГРУППИРОВАТЬ ПО
	ЭмоциональныеОценкиВопросов.Вопрос
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВопросыОтветыНаВопрос.Ссылка КАК Вопрос,
	ВопросыОтветыНаВопрос.НомерСтроки КАК НомерСтр,
	ВЫБОР
		КОГДА ОТБОР_Вопросы.Вопрос.ИспользоватьПредставление
			ТОГДА ВопросыОтветыНаВопрос.Представление
		ИНАЧЕ ВопросыОтветыНаВопрос.НомерСтроки
	КОНЕЦ КАК Представление
ПОМЕСТИТЬ Вопрос_НомерСтроки_Представление
ИЗ
	Справочник.Вопросы.ОтветыНаВопрос КАК ВопросыОтветыНаВопрос
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОТБОР_Вопросы КАК ОТБОР_Вопросы
		ПО ВопросыОтветыНаВопрос.Ссылка = ОТБОР_Вопросы.Вопрос
			И (ОТБОР_Вопросы.Вопрос.ВидВопроса = ЗНАЧЕНИЕ(Перечисление.ВидВопроса.ВопросСОтветом))

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ОТБОР_Вопросы.Вопрос,
	1,
	"тест"
ИЗ
	ОТБОР_Вопросы КАК ОТБОР_Вопросы
ГДЕ
	ОТБОР_Вопросы.Вопрос.ВидВопроса = ЗНАЧЕНИЕ(Перечисление.ВидВопроса.Тест)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ ПЕРВЫЕ 1
	МаршрутПроведенияИгры.Вопрос КАК Вопрос
ПОМЕСТИТЬ ТекущийВопросМаршрута
ИЗ
	РегистрСведений.МаршрутПроведенияИгры КАК МаршрутПроведенияИгры
ГДЕ
	МаршрутПроведенияИгры.Игра = &amp;Игра
	И МаршрутПроведенияИгры.АктивныйВопрос

УПОРЯДОЧИТЬ ПО
	МаршрутПроведенияИгры.НомерСледования УБЫВ
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	СтруктураИгры.Этап КАК Этап,
	СтруктураИгры.Вопрос КАК Вопрос,
	СтруктураИгры.НомерВопроса КАК НомерВопроса,
	ОтветыКоманд.Команда КАК Команда,
	ОтветыКоманд.НомерСтр КАК НомерПодвопроса,
	ОтветыКоманд.Ответ КАК Ответ,
	ОтветыКоманд.ОтветПравильный КАК ОтветПравильный,
	ОтветыКоманд.Баллы КАК Баллы,
	ОтветыКоманд.БаллыНоминальные КАК Номинал,
	ОтветыКоманд.ВремяОтвета КАК ВремяОтвета,
	ОтветыКоманд.Комментарий КАК Комментарий,
	ОтветыКоманд.Ответственный КАК Ответственный,
	ОтветыКоманд.АвтоматическаяПроверка КАК АвтоматическаяПроверка,
	Вопрос_НомерСтроки_Представление.Представление КАК Представление,
	ЕСТЬNULL(Г_ЭмоциональнаяОценкаВопросовИгры.ОбщаяЭмоциональнаяОценка, 0) КАК ОбщаяЭмоциональнаяОценка,
	ЕСТЬNULL(Г_ЭмоциональнаяОценкаВопросовИгры.КоличествоЛайков, 0) КАК КоличествоЛайков,
	ЕСТЬNULL(Г_ЭмоциональнаяОценкаВопросовИгры.КоличествоДизлайков, 0) КАК КоличествоДизлайков,
	ВЫБОР
		КОГДА НЕ ТекущийВопросМаршрута.Вопрос ЕСТЬ NULL
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ЭтоТекущийВопрос
ИЗ
	СтруктураИгры КАК СтруктураИгры
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветыКоманд КАК ОтветыКоманд
			ЛЕВОЕ СОЕДИНЕНИЕ Вопрос_НомерСтроки_Представление КАК Вопрос_НомерСтроки_Представление
			ПО ОтветыКоманд.Вопрос = Вопрос_НомерСтроки_Представление.Вопрос
				И ОтветыКоманд.НомерСтр = Вопрос_НомерСтроки_Представление.НомерСтр
		ПО СтруктураИгры.Вопрос = ОтветыКоманд.Вопрос
			И СтруктураИгры.Игра = ОтветыКоманд.Игра
		ЛЕВОЕ СОЕДИНЕНИЕ Г_ЭмоциональнаяОценкаВопросовИгры КАК Г_ЭмоциональнаяОценкаВопросовИгры
		ПО СтруктураИгры.Вопрос = Г_ЭмоциональнаяОценкаВопросовИгры.Вопрос
		ЛЕВОЕ СОЕДИНЕНИЕ ТекущийВопросМаршрута КАК ТекущийВопросМаршрута
		ПО СтруктураИгры.Вопрос = ТекущийВопросМаршрута.Вопрос

УПОРЯДОЧИТЬ ПО
	Этап,
	НомерВопроса,
	НомерПодвопроса</query>
