
Процедура ПриЗаписи(Отказ)
	
	// Изменение игры в Чате
	Если НЕ Отказ Тогда		
		
		// Отправка системного сообщения		
		Игра = Константы.ТекущаяИгра.Получить();
		ТекстСообщения = "Изменена игра на №" + СокрЛП(Игра.Номер + " " + СокрЛП(Игра.ОписаниеИгры));
		ИгровойСерверПривилегированный.ОтправитьСообщениеНаСервере(ТекстСообщения);
		
	КонецЕсли; 	
	
КонецПроцедуры
