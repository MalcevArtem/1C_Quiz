КонецФункции



// ОПЕРАТИВНЫЕ ФУНКЦИИ
Функция ПолучитьДанныеТекущегоВопроса(Игра) Экспорт
	
	// Как только устанавливается активный вопрос, то его данные обновляются системой согласно текущим 
	// и все пользователи начинают считывать этот новый вопрос
	// Старые при этом могут оставаться активными, но чтобы до них добраться
	// нужно сбросить активность всех следующих за ним записей
	//	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК ЕстьАктивныйВопрос,
	|	МаршрутПроведенияИгры.НомерСледования КАК НомерСледования,
	|	МаршрутПроведенияИгры.Вопрос КАК Вопрос,
	|	МаршрутПроведенияИгры.ДемонстрацияОтвета КАК ДемонстрацияОтвета,
	|	МаршрутПроведенияИгры.Длительность КАК Длительность,
	|	МаршрутПроведенияИгры.ВремяСтарта КАК ВремяСтарта,
	|	МаршрутПроведенияИгры.ВремяЗавершения КАК ВремяЗавершения,
	|	МаршрутПроведенияИгры.ВремяНачалаПаузы КАК ВремяНачалаПаузы,
	|	МаршрутПроведенияИгры.ВремяОкончанияПаузы КАК ВремяОкончанияПаузы,
	|	МаршрутПроведенияИгры.СтрокаСостояния КАК СтрокаСостояния
	|ИЗ
	|	РегистрСведений.МаршрутПроведенияИгры КАК МаршрутПроведенияИгры
	|ГДЕ
	|	МаршрутПроведенияИгры.Игра = &Игра
	|	И МаршрутПроведенияИгры.АктивныйВопрос
	|
	|УПОРЯДОЧИТЬ ПО
	|	МаршрутПроведенияИгры.НомерСледования УБЫВ";
	Запрос.УстановитьПараметр("Игра", Игра);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда // Игра еще не введена
		
		СтрВопрос = Новый Структура("ЕстьАктивныйВопрос,НомерСледования,Вопрос,ДемонстрацияОтвета,ВремяНачалаПаузы,ВремяОкончанияПаузы,ВремяЗавершения,СтрокаСостояния", Ложь, 0, Справочники.Вопросы.ПустаяСсылка(), Ложь, Дата(1,1,1), Дата(1,1,1), Дата(1,1,1));
		
	иначе	
		
		СтрВопрос = Новый Структура("ЕстьАктивныйВопрос,НомерСледования,Вопрос,ДемонстрацияОтвета,ВремяНачалаПаузы,ВремяОкончанияПаузы,ВремяЗавершения,СтрокаСостояния");	
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		ЗаполнитьЗначенияСвойств(СтрВопрос, Выборка);
		
	КонецЕсли;
	
	Возврат СтрВопрос;
	
КонецФункции	

Функция ПолучитьДанныеОтветовДругихИгроковКоманды(Игра, Вопрос, Команда, ВремяОтвета) Экспорт
	
	// ОПТИМИЗИРОВАННЫЙ ЗАПРОС МАХ быстрого считывания данных ответов игроков
	//
	
	МассивСтр = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОтветыИгроков.НомерСтр КАК НомерСтр,
	|	ОтветыИгроков.НомерИгрока КАК НомерИгрока,
	|	ОтветыИгроков.Ответ КАК Ответ
	|ИЗ
	|	РегистрСведений.ОтветыИгроков КАК ОтветыИгроков
	|ГДЕ
	|	ОтветыИгроков.Игра = &Игра
	|	И ОтветыИгроков.Вопрос = &Вопрос
	|	И ОтветыИгроков.Команда = &Команда
	|	И ОтветыИгроков.ВремяОтвета >= &ВремяОтвета
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтр,
	|	НомерИгрока";
	
	Запрос.УстановитьПараметр("ВремяОтвета", ВремяОтвета);
	Запрос.УстановитьПараметр("Игра",        Игра);
	Запрос.УстановитьПараметр("Вопрос",      Вопрос);
	Запрос.УстановитьПараметр("Команда",     Команда);
	
	
	// Формирование двумерного массива для передачи только &НаКлиент
	Результат = Запрос.Выполнить();	
	Если НЕ Результат.Пустой() Тогда
		
		ТекущийНомерСтр = 0;
		МассивОтветов   = Новый Массив;
		
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл			
			Если Выборка.НомерСтр<>ТекущийНомерСтр И ТекущийНомерСтр>0 Тогда // Изменилась строка, поэтому можно записать предыдцщую строку								
				// Запись строки:
				МассивСтр.Вставить(ТекущийНомерСтр-1, МассивОтветов);			
				// Новые параметры ответов
				МассивОтветов = Новый Массив;								
			КонецЕсли;				
			// Обновление текущего номера стр.
			ТекущийНомерСтр = Выборка.НомерСтр;
			// Добавление ответа для игрока
			МассивОтветов.Вставить(Выборка.НомерИгрока-1, Выборка.Ответ); 	
		КонецЦикла;
		
		// Запись строки (завершающая):
		МассивСтр.Вставить(ТекущийНомерСтр-1, МассивОтветов);
		
	КонецЕсли;
	
	Возврат МассивСтр; 
	
КонецФункции	

Функция ОтправитьДанныеОтветаИгрока(Игра, Вопрос, Команда, НомерСтр, НомерИгрока, Игрок, Ответ) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Игра) Тогда Возврат Неопределено; КонецЕсли; 
	
	// Отправка ответа игрока
	//
	ЗаписьОтветИгрока = РегистрыСведений.ОтветыИгроков.СоздатьМенеджерЗаписи();
